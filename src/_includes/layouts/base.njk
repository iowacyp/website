<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.shortName }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if robots %}
  <meta name="robots" content="{{ robots }}">
  {% endif %}
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  <link rel="stylesheet" href="/assets/css/site.css?v=20260810-events-2">
  <link rel="icon" href="/assets/pwa/icon-192.png" type="image/png">
  <meta property="og:title" content="{{ title or site.shortName }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
  <meta property="og:image" content="{{ site.domain }}{{ socialImage or '/assets/img/team/mission-bg.jpg' }}">
  <meta property="og:site_name" content="{{ site.shortName }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.shortName }}">
  <meta name="twitter:description" content="{{ description or site.tagline }}">
  <meta name="twitter:image" content="{{ site.domain }}{{ socialImage or '/assets/img/team/mission-bg.jpg' }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.domain }}",
    "logo": "{{ site.domain }}/assets/img/branding_symbol.png",
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.instagram }}"
    ],
    "contactPoint": [{
      "@type": "ContactPoint",
      "contactType": "Customer Support",
      "email": "{{ site.contactEmail }}",
      "telephone": "{{ site.contactPhone }}",
      "areaServed": "US"
    }],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Camp Dodge Rec Hall - 7105 NW 78th Ave Bldg 3585",
      "addressLocality": "Johnston",
      "addressRegion": "IA",
      "postalCode": "50131",
      "addressCountry": "US"
    }
  }
  </script>
  <script id="site-search-data" type="application/json">{{ jsonStringify(searchIndex) | safe }}</script>
</head>
<body class="font-sans text-slate-900 bg-bg">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2 bg-primary text-white shadow-md">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js?v=20260810-events" defer></script>
</body>
</html>
