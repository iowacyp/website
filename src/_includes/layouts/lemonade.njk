<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Lemonade Boss" }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="icon" href="/assets/pwa/icon-192.png" type="image/png">
  <meta property="og:title" content="{{ title or site.shortName }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
  <meta property="og:image" content="{{ site.domain }}/assets/img/team/mission-bg.jpg">
  <meta property="og:site_name" content="{{ site.shortName }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.shortName }}">
  <meta name="twitter:description" content="{{ description or site.tagline }}">
  <meta name="twitter:image" content="{{ site.domain }}/assets/img/team/mission-bg.jpg">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.domain }}",
    "logo": "{{ site.domain }}/assets/img/branding_symbol.png",
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.instagram }}"
    ]
  }
  </script>
  <script id="site-search-data" type="application/json">{{ jsonStringify(searchIndex) | safe }}</script>
</head>
<body class="font-sans text-slate-900 bg-bg">
  <main id="main">
    {{ content | safe }}
  </main>
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
