<footer class="mt-16 border-t border-secondary/40 bg-primary text-white">
  <div class="container py-10 grid gap-8 md:grid-cols-3">
    <div>
      <h2 class="font-light text-lg tracking-[0.1em] uppercase mb-3 text-white">About Iowa CYP</h2>
      <p class="text-white/90">Fostering community, resilience, and positive development among Iowa's military-connected children and families.</p>
      <a href="/support/" class="mt-4 inline-flex items-center gap-2 rounded-full bg-secondary px-5 py-2.5 text-sm font-semibold text-[#1f4d7a] shadow-sm transition hover:bg-[#f7c74a]">Get Involved</a>
    </div>
    <div>
      <h2 class="font-light text-lg tracking-[0.1em] uppercase mb-3 text-white">Connect</h2>
      <ul class="space-y-1 text-white/90">
        <li>
          <a class="social-link text-white hover:text-secondary" href="{{ site.social.facebook }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H8.078v-2.89h2.36V9.797c0-2.332 1.393-3.623 3.523-3.623 1.021 0 2.088.183 2.088.183v2.292h-1.177c-1.161 0-1.523.721-1.523 1.459v1.752h2.594l-.414 2.89h-2.18v6.987C18.343 21.128 22 16.99 22 12z" />
            </svg>
            <span>Facebook</span>
          </a>
        </li>
        <li>
          <a class="social-link text-white hover:text-secondary" href="{{ site.social.instagram }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M7 2c-2.757 0-5 2.243-5 5v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm0 2h10c1.654 0 3 1.346 3 3v10c0 1.654-1.346 3-3 3H7c-1.654 0-3-1.346-3-3V7c0-1.654 1.346-3 3-3zm10 1a1 1 0 110 2 1 1 0 010-2zM12 7c-2.757 0-5 2.243-5 5s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5zm0 2a3 3 0 110 6 3 3 0 010-6z" />
            </svg>
            <span>Instagram</span>
          </a>
        </li>
      </ul>
    </div>
    <div>
      <h2 class="font-light text-lg tracking-[0.1em] uppercase mb-3 text-white">Contact</h2>
      <ul class="space-y-2 text-white/90">
        <li class="flex items-start gap-3">
          <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-white/10 text-white/80">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="h-3.5 w-3.5"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg>
          </span>
          <span>{{ site.officeLocation }}</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-white/10 text-white/80">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="h-3.5 w-3.5"><path d="M16.487 15.56l-2.675-.305a1 1 0 00-.85.287l-1.02 1.046a11.055 11.055 0 01-4.53-4.53l1.046-1.02a1 1 0 00.287-.85l-.305-2.675A1.5 1.5 0 007.96 6H5.5A1.5 1.5 0 004 7.5C4 15.032 9.968 21 17.5 21a1.5 1.5 0 001.5-1.5V17.04a1.5 1.5 0 00-1.013-1.48z"/></svg>
          </span>
          <a class="text-white hover:text-secondary transition" href="tel:{{ site.contactPhone | replace('-', '') }}">{{ site.contactPhone }}</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-white/10 text-white/80">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="h-3.5 w-3.5"><path d="M20 4H4a2 2 0 00-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6a2 2 0 00-2-2zm0 2v.01L12 13 4 6.01V6h16zM4 18v-9.764l7.382 5.768a1 1 0 001.236 0L20 8.236V18H4z"/></svg>
          </span>
          <a class="text-white hover:text-secondary transition" href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>
        </li>
        {% if site.links.eventsSubscribe %}
          <li class="flex items-center gap-3">
            <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-white/10 text-white/80">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="h-3.5 w-3.5"><path d="M21.426 11.095l-17-8A.999.999 0 003.03 4.242l1.212 4.849L12 12l-7.758 2.909-1.212 4.849a1 1 0 001.396 1.147l17-8a1 1 0 000-1.81z"/></svg>
            </span>
            <a class="text-white hover:text-secondary transition" href="{{ site.links.eventsSubscribe }}">Join our mailing list</a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
  <div class="border-t border-secondary/40 py-4 text-center text-sm text-white/60">
    © <span id="year"></span> {{ site.name }}
  </div>
</footer>
