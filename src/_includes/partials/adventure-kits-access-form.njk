{% set formId = accessFormId or 'adventureKitsAccessForm' %}
{% set fieldIdPrefix = accessFieldIdPrefix or 'adventureKitsAccess' %}
{% set statusId = accessStatusId or formId ~ 'Status' %}
{% set prefix = fieldIdPrefix ~ '-' %}
{% set serviceAreas = ['Des Moines', 'Sioux City', 'Council Bluffs', 'Waterloo', 'Cedar Rapids', 'Davenport'] %}

<form id="{{ formId }}" class="content-card space-y-6" data-adventure-kits-access-form data-access-endpoint="/.netlify/functions/virtual-programming-signup-proxy">
  <p class="hidden"><label>Don’t fill this out if you’re human: <input name="bot-field"></label></p>
  <div class="grid gap-5 md:grid-cols-2">
    <div class="space-y-2"><label class="block text-sm font-semibold text-slate-800" for="{{ prefix }}parent_first_name">Parent/guardian first name</label><input id="{{ prefix }}parent_first_name" name="parent_first_name" required autocomplete="given-name" class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"></div>
    <div class="space-y-2"><label class="block text-sm font-semibold text-slate-800" for="{{ prefix }}parent_last_name">Parent/guardian last name</label><input id="{{ prefix }}parent_last_name" name="parent_last_name" required autocomplete="family-name" class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"></div>
    <div class="space-y-2"><label class="block text-sm font-semibold text-slate-800" for="{{ prefix }}email">Email</label><input id="{{ prefix }}email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"></div>
    <div class="space-y-2"><label class="block text-sm font-semibold text-slate-800" for="{{ prefix }}service_area">Service area / closest city</label><select id="{{ prefix }}service_area" name="service_area" required class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"><option value="" selected>Select a city</option>{% for city in serviceAreas %}<option>{{ city }}</option>{% endfor %}</select></div>
    <div class="space-y-2"><label class="block text-sm font-semibold text-slate-800" for="{{ prefix }}affiliation">Affiliation / program</label><select id="{{ prefix }}affiliation" name="affiliation" required class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"><option value="" selected>Select an option</option><option>Army National Guard</option><option>Air National Guard</option><option>Army Reserve</option><option>Active Duty</option><option>Veteran</option><option>Fallen Family</option><option>Other / Civilian Partner</option></select></div>
    <fieldset class="space-y-3 md:col-span-2"><legend class="block text-sm font-semibold text-slate-800">Number of children/youth by age range</legend><p class="text-sm text-slate-500">Enter 0 for any age range that does not apply.</p><div class="grid gap-4 sm:grid-cols-3"><div class="space-y-2"><label class="block text-sm font-medium text-slate-700" for="{{ prefix }}age_0_5">Ages 0-5</label><input id="{{ prefix }}age_0_5" name="age_0_5" type="number" min="0" max="25" step="1" value="0" required class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"></div><div class="space-y-2"><label class="block text-sm font-medium text-slate-700" for="{{ prefix }}age_6_12">Ages 6-12</label><input id="{{ prefix }}age_6_12" name="age_6_12" type="number" min="0" max="25" step="1" value="0" required class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"></div><div class="space-y-2"><label class="block text-sm font-medium text-slate-700" for="{{ prefix }}age_13_17">Ages 13-17</label><input id="{{ prefix }}age_13_17" name="age_13_17" type="number" min="0" max="25" step="1" value="0" required class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"></div></div></fieldset>
  </div>
  <label class="inline-flex items-start gap-3 text-sm text-slate-700"><input type="checkbox" name="quarterly_programming" class="mt-1 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary/50"><span>Also send our family quarterly virtual programming and Online Adventure Kit updates.</span></label>
  <label class="inline-flex items-start gap-3 text-sm text-slate-700"><input type="checkbox" name="mfrs_outreach" class="mt-1 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary/50"><span>I would like a Military Family Readiness Specialist to reach out to me.</span></label>
  <label class="inline-flex items-start gap-3 text-sm text-slate-700"><input type="checkbox" name="consent" required class="mt-1 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary/50"><span>I agree to receive Iowa CYP emails. I understand I can unsubscribe at any time.</span></label>
  <input type="hidden" name="source" value="www.iowacyp.com"><input type="hidden" name="tags" value="my-guard-family,online-adventure-kits,adventure-kits-access,website-gate">
  <p id="{{ statusId }}" class="text-sm text-slate-600" role="status" aria-live="polite" data-adventure-kits-access-status></p>
  <button type="submit" class="btn w-full md:w-auto" data-adventure-kits-access-submit>Get My Guard Family</button>
</form>
