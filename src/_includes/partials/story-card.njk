<article class="group flex min-w-0 flex-col overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/5 shadow-lg{% if isLatest %} snap-start{% endif %}"{% if isLatest %} data-story-slide{% endif %}{% if story.publishedISO %} data-published="{{ story.publishedISO }}"{% endif %}>
  <a class="flex h-full flex-col" href="/stories/{{ story.id }}/">
    <figure class="relative aspect-[4/3] overflow-hidden bg-slate-950">
      {% if story.cardFit == 'contain' %}
        <img src="{{ story.thumbnail }}" alt="" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-xl" aria-hidden="true" loading="lazy" decoding="async">
        <img src="{{ story.thumbnail }}" alt="{{ story.alt }}" class="absolute inset-0 h-full w-full object-contain transition duration-700 group-hover:scale-[1.02]" {{ imageAttrs(story.thumbnail) | safe }} loading="lazy" decoding="async">
      {% else %}
        <img src="{{ story.thumbnail }}" alt="{{ story.alt }}" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" style="object-position: {{ story.position }};" {{ imageAttrs(story.thumbnail) | safe }} loading="lazy" decoding="async">
      {% endif %}
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/10 to-transparent"></div>
      <p class="absolute inset-x-0 bottom-0 p-5 text-xs font-bold uppercase tracking-[0.22em] text-secondary">{{ story.eyebrow }}</p>
    </figure>
    <div class="flex flex-1 flex-col gap-2 p-5">
      <p class="text-xs uppercase tracking-[0.18em] text-white/55">{{ story.published }}</p>
      <h3 class="text-xl font-semibold leading-tight text-white">{{ story.title }}</h3>
      <p class="text-sm leading-relaxed text-white/75">{{ story.cardSummary or story.hook }}</p>
      <span class="mt-auto pt-2 text-sm font-bold text-secondary">Read full story</span>
    </div>
  </a>
</article>
