---
layout: layouts/kiosk.njk
title: Iowa CYP Story Gallery
description: An interactive event display featuring stories of Iowa National Guard youth and families.
permalink: /story-gallery/index.html
robots: noindex, nofollow, noarchive
searchExclude: true
eleventyExcludeFromCollections: true
---
<div class="story-kiosk min-h-screen bg-[radial-gradient(circle_at_10%_0%,rgba(244,180,27,0.17),transparent_30%),radial-gradient(circle_at_90%_20%,rgba(31,77,122,0.65),transparent_38%),linear-gradient(150deg,#081827,#102c49_48%,#07131f)]">
  <header class="sticky top-0 z-30 border-b border-white/10 bg-slate-950/85 px-[max(1rem,env(safe-area-inset-left))] py-3 backdrop-blur-xl">
    <div class="mx-auto flex max-w-[1500px] items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-3">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white p-2 shadow-lg shadow-black/20">
          <img src="/assets/img/branding_symbol.png" alt="" class="h-full w-full object-contain" {{ imageAttrs('/assets/img/branding_symbol.png') | safe }}>
        </div>
        <div class="min-w-0">
          <p class="truncate text-xs font-bold uppercase tracking-[0.24em] text-secondary">Iowa Child &amp; Youth Program</p>
          <h1 class="truncate text-xl font-semibold text-white sm:text-2xl">Stories of Impact</h1>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <span class="hidden items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-semibold text-white/75 sm:inline-flex" data-offline-status aria-live="polite">
          <span class="h-2.5 w-2.5 rounded-full bg-amber-400" data-offline-dot></span>
          <span data-offline-label>Preparing offline mode</span>
        </span>
        <button type="button" class="inline-flex min-h-12 items-center justify-center rounded-full bg-secondary px-4 py-3 text-sm font-bold text-slate-950 shadow-lg transition active:scale-[0.98] sm:px-6" data-start-attract>
          Start slideshow
        </button>
        <a href="/stories/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white transition active:scale-[0.98]">Exit</a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-[1500px] px-[max(1rem,env(safe-area-inset-left))] pb-[max(3rem,env(safe-area-inset-bottom))] pt-8 sm:px-6 lg:px-8">
    <section class="mb-8 grid gap-4 border-b border-white/10 pb-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-3xl space-y-3">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-secondary">Tap a photo to begin</p>
        <h2 class="font-heading text-4xl font-bold leading-tight text-white [text-shadow:0_3px_18px_rgba(0,0,0,0.75)] sm:text-5xl">Every story carries the mission forward.</h2>
        <p class="max-w-2xl text-lg leading-relaxed text-white/75">Meet Iowa's military-connected youth, families, volunteers, and partners through moments of leadership, resilience, and belonging.</p>
      </div>
      <p class="rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white/70">{{ storyGallery.items | length }} stories available</p>
    </section>

    <section id="story-gallery-grid" class="grid grid-cols-2 gap-4 lg:grid-cols-3 lg:gap-6" aria-label="Story gallery">
      {% for story in storyGallery.items %}
        <button type="button" class="group relative min-h-[19rem] overflow-hidden rounded-[1.75rem] border border-white/15 bg-slate-900 text-left shadow-2xl shadow-black/20 transition duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-secondary active:scale-[0.985] sm:min-h-[25rem]" data-story-id="{{ story.id }}" aria-label="Read {{ story.title }}">
          {%- if story.cardFit == 'contain' %}
            <img src="{{ story.thumbnail }}" alt="" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-55 blur-xl" aria-hidden="true" loading="lazy" decoding="async">
            <img src="{{ story.thumbnail }}" alt="{{ story.alt }}" class="absolute inset-0 h-full w-full object-contain transition duration-700 group-hover:scale-[1.02]" loading="{% if loop.index <= 6 %}eager{% else %}lazy{% endif %}" decoding="async">
          {%- else %}
            <img src="{{ story.thumbnail }}" alt="{{ story.alt }}" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" style="object-position: {{ story.position }};" loading="{% if loop.index <= 6 %}eager{% else %}lazy{% endif %}" decoding="async">
          {%- endif %}
          <span class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/5"></span>
          <span class="absolute inset-x-0 bottom-0 block space-y-3 p-4 sm:p-6">
            <span class="inline-flex rounded-full bg-secondary px-3 py-1 text-[0.6rem] font-bold uppercase tracking-[0.2em] text-slate-950 sm:text-xs">{{ story.eyebrow }}</span>
            <span class="block font-heading text-xl font-bold leading-tight text-white [text-shadow:0_3px_16px_rgba(0,0,0,0.95)] sm:text-3xl">{{ story.title }}</span>
            <span class="hidden text-sm leading-relaxed text-white/75 sm:block">{{ story.hook }}</span>
            <span class="inline-flex items-center gap-2 text-sm font-bold text-secondary">Open story <span aria-hidden="true">&rarr;</span></span>
          </span>
        </button>
      {% endfor %}
    </section>
  </main>
</div>

<section class="fixed inset-0 z-50 hidden bg-slate-100 text-slate-900" data-story-detail aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="kiosk-story-title">
  <div class="flex h-full flex-col">
    <header class="z-10 flex min-h-20 items-center justify-between gap-3 border-b border-slate-200 bg-white/95 px-[max(1rem,env(safe-area-inset-left))] py-3 shadow-sm backdrop-blur-xl sm:px-6">
      <button type="button" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-bold text-white active:scale-[0.98]" data-detail-close>
        <span aria-hidden="true">&larr;</span> All stories
      </button>
      <p class="hidden text-sm font-bold uppercase tracking-[0.2em] text-primary/60 sm:block" data-detail-count></p>
      <div class="flex gap-2">
        <button type="button" class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white text-xl font-bold text-primary shadow-sm active:scale-[0.96]" data-detail-prev aria-label="Previous story">&larr;</button>
        <button type="button" class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white text-xl font-bold text-primary shadow-sm active:scale-[0.96]" data-detail-next aria-label="Next story">&rarr;</button>
      </div>
    </header>
    <div class="flex-1 overflow-y-auto overscroll-contain" data-detail-scroll>
      <article data-detail-content></article>
    </div>
  </div>
</section>

<button type="button" class="fixed inset-0 z-[70] hidden overflow-hidden bg-slate-950 text-left text-white" data-attract aria-label="Open the featured story and pause slideshow" aria-hidden="true">
  <img src="" alt="" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-2xl transition-opacity duration-700" data-attract-backdrop aria-hidden="true">
  <img src="" alt="" class="absolute inset-0 h-full w-full object-contain transition-opacity duration-700" data-attract-image>
  <span class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/35"></span>
  <span class="absolute inset-0 flex items-end p-[max(2rem,env(safe-area-inset-bottom))] sm:items-center sm:p-16 lg:p-24">
    <span class="block max-w-3xl space-y-6">
      <span class="inline-flex rounded-full bg-secondary px-4 py-2 text-xs font-bold uppercase tracking-[0.25em] text-slate-950" data-attract-eyebrow></span>
      <span class="block font-heading text-5xl font-bold leading-[0.95] text-white [text-shadow:0_4px_22px_rgba(0,0,0,0.95)] sm:text-7xl" data-attract-title></span>
      <span class="block border-l-4 border-secondary pl-5 text-xl leading-relaxed text-white/85 sm:text-3xl" data-attract-quote></span>
      <span class="inline-flex rounded-full border border-white/25 bg-white/10 px-5 py-3 text-sm font-bold uppercase tracking-[0.18em] text-white backdrop-blur">Tap to explore</span>
    </span>
  </span>
  <span class="absolute right-6 top-[max(1.5rem,env(safe-area-inset-top))] rounded-full bg-slate-950/50 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-white/80 backdrop-blur" data-attract-count></span>
</button>
