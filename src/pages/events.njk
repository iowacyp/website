---
layout: layouts/base.njk
title: Iowa National Guard Family Events & Youth Programs
description: Find upcoming Iowa CYP camps, family events, Adventure Kits, teen leadership opportunities, and programs for Iowa National Guard children and families.
permalink: /events/
---
<section class="relative isolate overflow-hidden" data-reveal>
  <div class="relative min-h-[48vh] overflow-hidden">
    <div class="absolute inset-0" data-video-shell>
      <img src="/assets/img/stories/1o4a5684.jpg" alt="" class="video-poster" aria-hidden="true" {{ imageAttrs('/assets/img/stories/1o4a5684.jpg') }} decoding="async">
      <video
        class="video-fade h-full w-full object-cover object-center brightness-75 saturate-90 contrast-110"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        data-video-fade
        data-video-lazy
        aria-hidden="true"
      >
        <source src="/content/Media/5027202-uhd_4096_2160_30fps.mp4" type="video/mp4">
      </video>
      <noscript>
        <img
          src="/assets/img/stories/1o4a5684.jpg"
          alt="Guard youth connecting during an Iowa CYP weekend"
          class="absolute inset-0 h-full w-full object-cover"
          {{ imageAttrs('/assets/img/stories/1o4a5684.jpg') }}
          loading="lazy"
          decoding="async"
        >
      </noscript>
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/94 via-slate-950/82 to-slate-950/60 pointer-events-none"></div>
    <div class="container relative min-h-[48vh] py-16 md:py-20 flex items-center justify-center">
      <div class="max-w-3xl rounded-[2rem] border border-white/10 bg-slate-950/88 p-6 md:p-8 text-white space-y-5 text-center shadow-2xl backdrop-blur-md">
        <p class="text-sm uppercase tracking-[0.15em] text-secondary">Iowa CYP Events</p>
        <h1 class="text-3xl md:text-4xl font-semibold text-white">Events for Guard families</h1>
        <p class="text-white/90 text-base md:text-lg leading-relaxed">Be first to know about camps, celebrations, and workshops for Iowa's military-connected youth.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a class="hero-cta" href="#upcoming">Browse upcoming events</a>
          <a class="hero-cta-secondary" href="{{ site.links.eventsSubscribe }}">Subscribe for updates</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-slate-50 py-14 md:py-16 border-t border-primary/10" id="upcoming" data-reveal>
  <div class="container space-y-12">
    <div class="mx-auto max-w-3xl space-y-4 text-center">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">2026–27 Program Year</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Plan your year with Iowa CYP</h2>
      <p class="text-slate-700 leading-relaxed">Find next program year&rsquo;s events organized by fall, spring, and summer. Event details come directly from our registration system and are updated as plans are finalized.</p>
    </div>
    <div id="eventsList" class="space-y-6" aria-live="polite" aria-busy="false">
      {% for event in events.events | upcomingEvents %}
        {% if event.showOnWebsite %}
          <article class="rounded-3xl border border-primary/15 bg-white p-6 shadow-sm" data-reveal>
            <div class="grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)] md:items-start">
              <div>
                <time class="font-semibold text-primary" datetime="{{ event.date }}">{{ event.displayDate }}</time>
                {% if event.time %}<p class="mt-1 text-sm text-slate-600">{{ event.time }}</p>{% endif %}
              </div>
              <div class="space-y-3">
                <h3 class="text-xl font-semibold text-slate-900">{{ event.title }}</h3>
                {% if event.location %}<p class="font-medium text-slate-700">{{ event.location }}</p>{% endif %}
                {% if event.notes %}<p class="leading-relaxed text-slate-700">{{ event.notes }}</p>{% endif %}
                {% if event.registrationCode %}
                  <aside class="rounded-2xl border-2 border-amber-400 bg-amber-50 p-4 text-slate-900" aria-label="Important registration information">
                    <p class="font-semibold">Important registration information</p>
                    {% if event.registrationNotice %}<p class="mt-2 leading-relaxed">{{ event.registrationNotice }}</p>{% endif %}
                    <p class="mt-3">Promo code: <strong class="rounded bg-white px-2 py-1 font-mono text-lg tracking-wide text-primary">{{ event.registrationCode }}</strong></p>
                  </aside>
                {% endif %}
                {% if event.ctaUrl and not event.ctaDisabled %}
                  {% if event.registrationInstructionsFile %}
                    <button class="btn inline-flex" type="button" data-modal-open="camp-registration-{{ event.adminId }}">{{ event.ctaLabel or 'View registration steps' }}</button>
                  {% else %}
                    <a class="btn inline-flex" href="{{ event.ctaUrl }}"{% if event.ctaUrl[0] != '/' %} target="_blank" rel="noopener"{% endif %}>{{ event.ctaLabel or 'View event details' }}{% if event.ctaUrl[0] != '/' %}<span class="sr-only"> (opens in new tab)</span>{% endif %}</a>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          </article>

          {% if event.registrationInstructionsFile and event.ctaUrl %}
            <div class="modal hidden fixed inset-0 z-[130] p-4 sm:p-6 lg:p-8" data-modal="camp-registration-{{ event.adminId }}" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="camp-registration-{{ event.adminId }}-title" tabindex="-1">
              <div class="absolute inset-0 bg-slate-950/75 backdrop-blur-sm" data-modal-overlay></div>
              <article class="relative mx-auto flex w-full max-w-3xl flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-2xl max-h-[calc(100svh-2rem)]">
                <header class="flex items-start justify-between gap-4 border-b border-slate-100 px-5 py-4 sm:px-7 sm:py-6">
                  <div class="space-y-1">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary/60">Before you register</p>
                    <h2 id="camp-registration-{{ event.adminId }}-title" class="text-2xl font-semibold normal-case tracking-tight text-slate-900">Summer Camp registration steps</h2>
                  </div>
                  <button type="button" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition hover:bg-slate-200 hover:text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/30" data-modal-close aria-label="Close registration instructions">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                  </button>
                </header>

                <div class="flex-1 overflow-y-auto px-5 py-5 sm:px-7 sm:py-6">
                  <div class="space-y-5">
                    <div class="rounded-2xl border-2 border-amber-400 bg-amber-50 p-4 text-slate-900">
                      <p class="font-semibold">The site will first show that you owe $635.</p>
                      <p class="mt-1 leading-relaxed">This is expected. Enter promo code <strong class="rounded bg-white px-2 py-1 font-mono text-lg tracking-wide text-primary">{{ event.registrationCode }}</strong> at checkout and click <strong>Apply</strong>. Make sure the balance changes to <strong>$25</strong> before paying.</p>
                    </div>

                    <ol class="list-decimal space-y-3 pl-5 leading-relaxed text-slate-700">
                      <li>Create a new YMCA Camp account, or sign in to your existing account.</li>
                      <li>Open <strong>Manage People and Household Information</strong> and update the parent and child information.</li>
                      <li>Under <strong>Start a New Application</strong>, select <strong>Summer 2027</strong> and choose the child you are registering.</li>
                      <li>Under <strong>Partner Camps</strong>, open <strong>Iowa Army National Guard Youth Symposium Camp, July 18-24, 2027</strong>, and add it to your cart.</li>
                      <li>At checkout, enter <strong>{{ event.registrationCode }}</strong>, click <strong>Apply</strong>, and confirm the amount due is <strong>$25</strong>.</li>
                      <li>Continue through the remaining steps, complete the required forms, and submit payment.</li>
                    </ol>

                    <p class="text-sm leading-relaxed text-slate-600">The downloadable guide includes screenshots showing each step in the registration system.</p>
                  </div>
                </div>

                <footer class="flex flex-col-reverse gap-3 border-t border-slate-100 bg-slate-50 px-5 py-4 sm:flex-row sm:justify-end sm:px-7">
                  <a class="btn-secondary" href="{{ event.registrationInstructionsFile }}" download>Download screenshot instructions</a>
                  <a class="btn" href="{{ event.ctaUrl }}" target="_blank" rel="noopener">Continue to registration<span class="sr-only"> (opens in new tab)</span></a>
                </footer>
              </article>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn" href="{{ site.links.eventsSubscribe }}">Get event emails</a>
      <a class="btn-secondary" href="/contact/#general-contact">Ask the team</a>
    </div>
  </div>
</section>

<section id="past-events" class="bg-white py-16" data-reveal>
  <div class="container space-y-8">
    <header class="max-w-3xl space-y-3">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Past events</h2>
      <p class="text-slate-700">Look back at previous Iowa CYP gatherings for Guard-connected families.</p>
    </header>
    <div id="pastEventsList" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {% for event in events | pastEvents %}
        <article class="content-card space-y-3 border border-slate-200 bg-slate-50" data-reveal>
          <span class="text-xs font-semibold uppercase tracking-wide text-slate-600">Completed</span>
          <h3 class="text-lg font-semibold text-slate-800">{{ event.title }}</h3>
          <p class="text-sm text-slate-600"><time datetime="{{ event.date }}">{{ event.displayDate or event.date }}</time></p>
          {% if event.location %}<p class="text-sm text-slate-600">{{ event.location }}</p>{% endif %}
          {% if event.notes %}<p class="text-sm text-slate-600">{{ event.notes }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="programs" class="bg-primary/5 py-16 md:py-20" data-reveal>
  <div class="container space-y-8">
    <header class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Programs</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Programs Guard-connected youth keep coming back for</h2>
      <p class="text-slate-700 leading-relaxed">Adventure kits, camps, and leadership opportunities keep Guard-connected youth connected all year. These highlights give partners and caregivers a quick look at what Iowa CYP offers families.</p>
    </header>
    <article aria-labelledby="lemonade-boss-heading" class="lemonade-feature relative overflow-hidden rounded-3xl border border-primary/10 bg-[radial-gradient(circle_at_top_left,rgba(255,214,92,0.34),transparent_32%),radial-gradient(circle_at_top_right,rgba(191,227,139,0.34),transparent_28%),linear-gradient(135deg,rgba(255,251,242,0.98),rgba(255,247,225,0.95))] px-0 py-6 md:py-10 lg:min-h-[clamp(34rem,60vw,44rem)]">
      <img src="/assets/img/lemonade.png" alt="" class="absolute inset-0 h-full w-full object-cover object-right pointer-events-none select-none" {{ imageAttrs('/assets/img/lemonade.png') }} loading="lazy" decoding="async" aria-hidden="true">
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(255,251,242,0.98)_0%,rgba(255,247,225,0.94)_28%,rgba(255,247,225,0.72)_46%,rgba(255,247,225,0.08)_68%,rgba(255,247,225,0)_100%)]"></div>
      <div class="relative z-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:min-h-[clamp(34rem,60vw,44rem)] px-6 md:px-10">
        <div class="space-y-6 max-w-3xl">
          <span class="inline-flex items-center gap-3 rounded-full bg-white/85 px-5 py-3 text-xs font-semibold uppercase tracking-[0.22em] text-[#1f4d7a] shadow-sm">
            <span aria-hidden="true">🍋</span>
            Major update
          </span>
          <div class="space-y-4">
            <h3 id="lemonade-boss-heading" class="max-w-3xl text-4xl md:text-5xl font-semibold normal-case tracking-tight text-slate-950">Teach your child the basics of business.</h3>
            <p class="max-w-2xl text-lg md:text-xl leading-relaxed text-slate-700">This workbook and app help kids practice idea building, simple budgeting, pricing, marketing, and confidence through a hands-on lemonade stand challenge.</p>
          </div>
          <div class="flex flex-wrap gap-4 pt-2">
            <a class="inline-flex items-center justify-center rounded-full bg-[#1f4d7a] px-6 py-4 text-base font-semibold text-white shadow-[0_18px_30px_-20px_rgba(31,77,122,0.55)] transition hover:-translate-y-0.5 hover:bg-[#173b5e]" href="/lemonade-boss/">Open the workbook &amp; app</a>
            <a class="inline-flex items-center justify-center rounded-full border border-[#9cb7da] bg-white/75 px-6 py-4 text-base font-semibold text-[#1f4d7a] shadow-sm transition hover:-translate-y-0.5 hover:bg-white" href="/lemonade-boss/">See what's included</a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<div class="stp-member-scroll bg-primary/5">
{% for program in programs.items %}
  {% set isAlt = loop.index0 % 2 == 1 %}
  {% set ctaExternal = program.cta and program.cta.url and program.cta.url[0] != '/' %}
  {% set ctaLabel = program.cta.label if program.cta and program.cta.label else 'Learn More' %}
  <section id="program-{{ program.id | lower }}" class="stp-member story-feature{% if isAlt %} stp-member--reverse{% endif %}" data-reveal>
    <div class="container grid gap-5 px-8{% if program.image %} md:grid-cols-2 md:items-center md:gap-10 lg:gap-16{% endif %}">
      {% if program.image %}
        <figure class="stp-member__portrait-wrap{% if isAlt %} md:order-2{% endif %}">
          <div class="stp-member__halo" aria-hidden="true"></div>
          <img
            src="{{ program.image }}"
            alt="{{ program.name }}"
            class="stp-member__portrait rounded-3xl"
            {{ imageAttrs(program.image) }}
            loading="lazy"
            decoding="async"
          >
        </figure>
      {% endif %}
      <div class="stp-member__content space-y-6{% if program.image and isAlt %} md:order-1{% endif %}">
        <div class="space-y-3">
          {% if program.type %}
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-secondary/70">{{ program.type }}</p>
          {% endif %}
          <h3 class="text-2xl md:text-3xl font-semibold text-slate-900">{{ program.name }}</h3>
          {% if program.targetAudience %}
            <p class="text-sm font-semibold text-primary/80">Best for: {{ program.targetAudience }}</p>
          {% endif %}
          <p class="text-base text-gray-700 leading-relaxed">{{ program.description }}</p>
        </div>
        {% if program.quote %}
          <blockquote class="rounded-3xl border border-primary/15 bg-primary/5 p-6 text-primary italic leading-relaxed shadow-sm">
            &ldquo;{{ program.quote.text }}&rdquo;
            {% if program.quote.attribution %}
              <span class="mt-4 block text-xs font-semibold uppercase tracking-wide text-primary/60 not-italic">- {{ program.quote.attribution }}</span>
            {% endif %}
          </blockquote>
        {% endif %}
        {% if program.cta %}
          <div class="flex flex-wrap gap-3">
            {% if program.cta.disabled %}
              <span class="btn w-fit cursor-default" aria-disabled="true">{{ ctaLabel }}</span>
            {% else %}
              <a class="btn" href="{{ program.cta.url }}"{% if ctaExternal %} target="_blank" rel="noopener"{% endif %}>
                {{ ctaLabel }}
                {% if ctaExternal %}<span class="sr-only">(opens in new tab)</span>{% endif %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endfor %}
</div>

<script id="eventStructuredData" type="application/ld+json">{{ eventStructuredData(events, site) | safe }}</script>
