---
layout: layouts/base.njk
title: Iowa National Guard Family Events & Youth Programs
description: Find upcoming Iowa CYP camps, family events, Adventure Kits, teen leadership opportunities, and programs for Iowa National Guard children and families.
permalink: /events/
---
<section class="relative isolate overflow-hidden" data-reveal>
  <div class="relative min-h-[60vh] md:min-h-[70vh] overflow-hidden">
    <div class="absolute inset-0" data-video-shell>
      <img src="/assets/img/stories/1o4a5684.jpg" alt="" class="video-poster" aria-hidden="true" {{ imageAttrs('/assets/img/stories/1o4a5684.jpg') }} decoding="async">
      <video
        class="video-fade h-full w-full object-cover object-center brightness-75 saturate-90 contrast-110"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        data-video-fade
        data-video-lazy
        aria-hidden="true"
      >
        <source src="/content/Media/5027202-uhd_4096_2160_30fps.mp4" type="video/mp4">
      </video>
      <noscript>
        <img
          src="/assets/img/stories/1o4a5684.jpg"
          alt="Guard youth connecting during an Iowa CYP weekend"
          class="absolute inset-0 h-full w-full object-cover"
          {{ imageAttrs('/assets/img/stories/1o4a5684.jpg') }}
          loading="lazy"
          decoding="async"
        >
      </noscript>
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/94 via-slate-950/80 to-slate-950/55 pointer-events-none"></div>
    <div class="container relative min-h-[60vh] md:min-h-[70vh] flex items-center justify-center text-white py-12 md:py-16 text-center">
      <div class="max-w-3xl md:max-w-2xl rounded-[2rem] border border-white/10 bg-slate-950/88 p-6 md:p-10 text-white space-y-6 shadow-2xl backdrop-blur-md">
        <h1 class="text-3xl md:text-4xl font-semibold uppercase tracking-[0.15em] text-white flex flex-col gap-2">
          <span>Events</span>
          <span>For</span>
          <span>Guard</span>
          <span>Families</span>
        </h1>
        <p class="text-white/90 text-base md:text-lg leading-relaxed">Be first to know about camps, celebrations, and workshops for Iowa's military-connected youth.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a class="hero-cta" href="{{ site.links.eventsSubscribe }}">Subscribe for updates</a>
          <a class="hero-cta-secondary" href="/contact/#general-contact">Email a question</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-slate-50 py-14 md:py-16 border-t border-primary/10" id="upcoming" data-reveal>
  <div class="container space-y-12">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">2026–27 Program Year</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Plan your year with Iowa CYP</h2>
      <p class="text-slate-700 leading-relaxed">Find next program year&rsquo;s events organized by fall, spring, and summer. Event details come directly from our registration system and are updated as plans are finalized.</p>
    </div>
    <div id="eventsList" class="space-y-6" aria-live="polite" aria-busy="false">
      {% for event in events.events %}
        {% if event.showOnWebsite %}
          <article class="rounded-3xl border border-primary/15 bg-white p-6 shadow-sm">
            <div class="grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)] md:items-start">
              <div>
                <time class="font-semibold text-primary" datetime="{{ event.date }}">{{ event.displayDate }}</time>
                {% if event.time %}<p class="mt-1 text-sm text-slate-600">{{ event.time }}</p>{% endif %}
              </div>
              <div class="space-y-3">
                <h3 class="text-xl font-semibold text-slate-900">{{ event.title }}</h3>
                {% if event.location %}<p class="font-medium text-slate-700">{{ event.location }}</p>{% endif %}
                {% if event.notes %}<p class="leading-relaxed text-slate-700">{{ event.notes }}</p>{% endif %}
                {% if event.ctaUrl and not event.ctaDisabled %}
                  <a class="btn inline-flex" href="{{ event.ctaUrl }}">{{ event.ctaLabel or 'View event details' }}</a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn" href="{{ site.links.eventsSubscribe }}">Get event emails</a>
      <a class="btn-secondary" href="/contact/#general-contact">Ask the team</a>
    </div>
  </div>
</section>

<section id="programs" class="bg-primary/5 py-16 md:py-20" data-reveal>
  <div class="container space-y-8">
    <header class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Programs</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Programs Guard-connected youth keep coming back for</h2>
      <p class="text-slate-700 leading-relaxed">Adventure kits, camps, and leadership opportunities keep Guard-connected youth connected all year. These highlights give partners and caregivers a quick look at what Iowa CYP offers families.</p>
    </header>
  </div>
</section>

{% for program in programs.items %}
  {% set isAlt = loop.index0 % 2 == 1 %}
  {% set sectionBg = "bg-white" if not isAlt else "bg-primary/5" %}
  {% set imageOrder = "lg:order-last" if isAlt else "" %}
  {% set copyOrder = "lg:order-first lg:pr-6" if isAlt else "lg:pl-6" %}
  {% set ctaExternal = program.cta and program.cta.url and program.cta.url[0] != '/' %}
  {% set ctaLabel = program.cta.label if program.cta and program.cta.label else 'Learn More' %}
  <section id="program-{{ program.id | lower }}" class="{{ sectionBg }} py-16 md:py-20" data-reveal>
    <div class="container grid gap-10 lg:grid-cols-2 lg:items-stretch">
      {% if program.image %}
        <div class="h-full overflow-hidden {{ imageOrder }}">
          <img
            src="{{ program.image }}"
            alt="{{ program.name }}"
            class="h-full w-full object-cover object-center"
            {{ imageAttrs(program.image) }}
            loading="lazy"
            decoding="async"
          >
        </div>
      {% endif %}
      <div class="space-y-6 max-w-2xl flex flex-col justify-center {{ copyOrder }}">
        <div class="space-y-3">
          {% if program.type %}
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-secondary/70">{{ program.type }}</p>
          {% endif %}
          <h3 class="text-2xl md:text-3xl font-semibold text-slate-900">{{ program.name }}</h3>
          {% if program.targetAudience %}
            <p class="text-sm font-semibold text-primary/80">Best for: {{ program.targetAudience }}</p>
          {% endif %}
          <p class="text-base text-gray-700 leading-relaxed">{{ program.description }}</p>
        </div>
        {% if program.quote %}
          <blockquote class="rounded-3xl border border-primary/15 bg-primary/5 p-6 text-primary italic leading-relaxed shadow-sm">
            &ldquo;{{ program.quote.text }}&rdquo;
            {% if program.quote.attribution %}
              <span class="mt-4 block text-xs font-semibold uppercase tracking-wide text-primary/60 not-italic">- {{ program.quote.attribution }}</span>
            {% endif %}
          </blockquote>
        {% endif %}
        {% if program.cta %}
          <div class="flex flex-wrap gap-3">
            {% if program.cta.disabled %}
              <span class="btn w-fit cursor-default" aria-disabled="true">{{ ctaLabel }}</span>
            {% else %}
              <a class="btn" href="{{ program.cta.url }}"{% if ctaExternal %} target="_blank" rel="noopener"{% endif %}>
                {{ ctaLabel }}
                {% if ctaExternal %}<span class="sr-only">(opens in new tab)</span>{% endif %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endfor %}

<script id="eventStructuredData" type="application/ld+json">{{ eventStructuredData(events, site) | safe }}</script>
