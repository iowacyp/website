<style>
  .lemonade-page {
    position: relative;
    overflow: hidden;
    color: #21303f;
    background:
      radial-gradient(circle at 10% 0%, rgba(255, 214, 92, 0.38), transparent 28%),
      radial-gradient(circle at 86% 10%, rgba(191, 227, 139, 0.38), transparent 24%),
      linear-gradient(180deg, #fffdf5 0%, #fff6db 38%, #eef7d2 100%);
  }

  .lemonade-page::before,
  .lemonade-page::after {
    content: "";
    position: absolute;
    inset: auto;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.55;
  }

  .lemonade-page::before {
    top: 6rem;
    right: -8rem;
    width: 16rem;
    height: 16rem;
    background: rgba(255, 213, 79, 0.35);
  }

  .lemonade-page::after {
    bottom: 8rem;
    left: -6rem;
    width: 14rem;
    height: 14rem;
    background: rgba(191, 227, 139, 0.32);
  }

  .lemonade-shell {
    position: relative;
    z-index: 1;
  }

  .lemonade-hero {
    position: relative;
    display: grid;
    gap: 1.75rem;
    align-items: center;
    overflow: hidden;
    border: 1px solid rgba(36, 48, 67, 0.08);
    border-radius: 2.75rem;
    background:
      radial-gradient(circle at top left, rgba(255, 214, 92, 0.22), transparent 33%),
      radial-gradient(circle at top right, rgba(191, 227, 139, 0.26), transparent 28%),
      linear-gradient(135deg, rgba(255, 251, 242, 0.98), rgba(255, 247, 225, 0.95));
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 30px 80px -52px rgba(36, 48, 67, 0.5);
    backdrop-filter: blur(12px);
  }

  .lemonade-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }

  .lemonade-hero__bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  .lemonade-hero__bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255, 251, 242, 0.98) 0%, rgba(255, 247, 225, 0.94) 32%, rgba(255, 247, 225, 0.72) 50%, rgba(255, 247, 225, 0.1) 72%, rgba(255, 247, 225, 0) 100%);
  }

  .lemonade-hero__text {
    display: grid;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  .lemonade-hero__copy {
    display: grid;
    gap: 1.25rem;
  }

  .lemonade-pill,
  .lemonade-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .lemonade-pill {
    background: rgba(255, 213, 79, 0.24);
    color: #7a5536;
  }

  .lemonade-badge {
    background: rgba(36, 48, 67, 0.08);
    color: #21303f;
  }

  .lemonade-hero h2,
  .lemonade-section h2,
  .lemonade-card h3 {
    text-transform: none;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .lemonade-hero h2 {
    font-size: clamp(2.8rem, 6.7vw, 5.25rem);
    color: #21303f;
    max-width: 10ch;
  }

  .lemonade-hero__lead {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    max-width: 34rem;
  }

  .lemonade-hero p,
  .lemonade-section p {
    line-height: 1.75;
    color: #4b5563;
  }

  .lemonade-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lemonade-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.95rem 1.35rem;
    font-weight: 700;
    font-size: 0.98rem;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    box-shadow: 0 18px 30px -20px rgba(36, 48, 67, 0.45);
  }

  .lemonade-btn--primary {
    background: #1f4d7a;
    color: #ffffff;
  }

  .lemonade-btn--secondary {
    background: rgba(255, 255, 255, 0.82);
    color: #1f4d7a;
    border: 1px solid rgba(31, 77, 122, 0.18);
  }

  .lemonade-btn--ghost {
    background: rgba(255, 255, 255, 0.72);
    color: #21303f;
    border: 1px solid rgba(36, 48, 67, 0.12);
  }

  .lemonade-btn:hover,
  .lemonade-btn:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 22px 34px -22px rgba(36, 48, 67, 0.6);
    outline: none;
  }

  .lemonade-showcase {
    display: grid;
    gap: 1rem;
  }

  .lemonade-showcase__frame {
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(36, 48, 67, 0.08);
    background: #ffffff;
    box-shadow: 0 24px 40px -32px rgba(36, 48, 67, 0.55);
  }

  .lemonade-showcase__frame img {
    display: block;
    width: 100%;
    height: clamp(220px, 40vw, 380px);
    object-fit: cover;
  }

  .lemonade-stats {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lemonade-stat {
    border-radius: 1.5rem;
    border: 1px solid rgba(36, 48, 67, 0.08);
    background: rgba(255, 255, 255, 0.8);
    padding: 1rem;
    text-align: center;
  }

  .lemonade-stat strong {
    display: block;
    font-size: 1.15rem;
    color: #21303f;
  }

  .lemonade-stat span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #6b7280;
  }

  .lemonade-section {
    margin-top: clamp(3.5rem, 8vw, 5rem);
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 2.25rem;
    border: 1px solid rgba(36, 48, 67, 0.08);
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 20px 48px -38px rgba(36, 48, 67, 0.42);
    backdrop-filter: blur(12px);
  }

  .lemonade-section.green {
    background: linear-gradient(180deg, rgba(191, 227, 139, 0.35) 0%, rgba(191, 227, 139, 0.55) 100%);
  }

  .lemonade-section.sunny {
    background: linear-gradient(180deg, rgba(255, 213, 79, 0.25) 0%, rgba(255, 213, 79, 0.45) 100%);
  }

  .lemonade-section h2 {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    margin-bottom: 0.5rem;
    color: #243043;
  }

  .lemonade-section__lead {
    max-width: 56rem;
  }

  .lemonade-grid,
  .lemonade-steps {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .lemonade-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .lemonade-step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.82);
    border-radius: 1.75rem;
    box-shadow: inset 0 0 0 1px rgba(36, 48, 67, 0.08);
  }

  .lemonade-step__icon {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: #ffd54f;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    box-shadow: 0 8px 18px -12px rgba(36, 48, 67, 0.35);
  }

  .lemonade-card {
    background: #ffffff;
    border-radius: 1.75rem;
    padding: 1.75rem;
    box-shadow: 0 18px 38px -30px rgba(36, 48, 67, 0.45);
    display: grid;
    gap: 1rem;
  }

  .lemonade-feature-card {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 2rem;
    padding: 1.5rem 1.25rem 1.75rem;
    border: 1px solid rgba(36, 48, 67, 0.08);
    box-shadow: 0 20px 42px -32px rgba(36, 48, 67, 0.45);
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    text-align: center;
  }

  .lemonade-feature-card__icon {
    width: 6.75rem;
    height: 6.75rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: #1f4d7a;
  }

  .lemonade-feature-card__icon--gold {
    background: #fff3cf;
  }

  .lemonade-feature-card__icon--green {
    background: #e8f1d0;
  }

  .lemonade-feature-card__icon--blue {
    background: #e3effb;
  }

  .lemonade-card h3 {
    font-size: 1.35rem;
    color: #21303f;
  }

  .lemonade-card ul {
    padding-left: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .lemonade-footer {
    margin-top: clamp(3.5rem, 8vw, 5rem);
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: 2rem;
    background: #243043;
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
  }

  .lemonade-footer h2 {
    color: #ffd54f;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 1024px) {
    .lemonade-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: clamp(34rem, 60vw, 44rem);
    }
  }

  @media (min-width: 768px) {
    .lemonade-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lemonade-btn {
      transition: none;
    }
  }
</style>

<div class="lemonade-page">
  <div class="lemonade-shell container py-10 md:py-14">
    <section class="lemonade-section sunny" data-reveal data-lemonade-boss-gate>
      <div class="max-w-3xl space-y-4">
        <span class="lemonade-badge bg-white/70">Access required</span>
        <h1 class="text-3xl md:text-4xl font-semibold text-slate-900 normal-case tracking-tight">Unlock a workbook and app that teach business basics</h1>
        <p class="lemonade-section__lead">Sign up to get a family-friendly entrepreneurship activity that helps kids learn planning, pricing, budgeting, marketing, and how to talk about their idea with confidence.</p>
      </div>
      {% set accessFormId = 'lemonadeBossAccessForm' %}
      {% set accessStatusId = 'lemonadeBossAccessStatus' %}
      {% set accessSource = 'www.iowacyp.com' %}
      {% set accessTags = 'lemonade-boss-access,website-gate' %}
      {% include "partials/lemonade-boss-access-form.njk" %}
    </section>

    <div data-lemonade-boss-content hidden>
      <section class="lemonade-hero" data-reveal>
        <div class="lemonade-hero__bg" aria-hidden="true">
          <img src="/assets/img/lemonade.png" alt="" {{ imageAttrs('/assets/img/lemonade.png') }} loading="eager" decoding="async">
        </div>
        <div class="lemonade-hero__text">
          <span class="lemonade-pill">
            <span aria-hidden="true">🍋</span>
            Skills for life
          </span>
          <div class="lemonade-hero__copy">
            <h2>Teach your child the basics of business</h2>
            <p class="lemonade-hero__lead">The workbook and app help kids practice idea building, simple budgeting, pricing, marketing, and confidence through a hands-on lemonade stand challenge.</p>
          </div>
          <div class="lemonade-actions">
            <a class="lemonade-btn lemonade-btn--primary" href="{{ site.links.lemonadeBossApp }}" target="_blank" rel="noopener">Open the app</a>
            <a class="lemonade-btn lemonade-btn--ghost" href="/assets/files/Lemonade_Boss_Workbook.pdf" target="_blank" rel="noopener">Download the workbook</a>
            <a class="lemonade-btn lemonade-btn--secondary" href="#what-changed">See what's included</a>
          </div>
        </div>
      </section>

      <section class="lemonade-section" id="what-changed" data-reveal>
      <div class="max-w-3xl space-y-4">
        <span class="lemonade-badge bg-white/70">What it teaches</span>
        <h2>Lemonade Boss turns a simple stand into a business lesson</h2>
        <p class="lemonade-section__lead">Kids use the workbook and app to walk through the same steps real businesses use: naming an idea, planning supplies, setting prices, promoting the stand, and reflecting on what happened next.</p>
      </div>
      <div class="lemonade-grid">
        <article class="lemonade-card">
          <h3>Idea to plan</h3>
          <p>Kids choose a concept, define the customer, and sketch out how the stand will work before they try anything live.</p>
        </article>
        <article class="lemonade-card">
          <h3>Money and pricing</h3>
          <p>Simple budgeting tools help children see how costs, prices, and sales connect to profit.</p>
        </article>
        <article class="lemonade-card">
          <h3>Pitch and promote</h3>
          <p>Prompts in the app and workbook help kids practice describing their business and inviting people to buy in.</p>
        </article>
      </div>
    </section>

      <section class="lemonade-section sunny" data-reveal>
      <div class="max-w-3xl space-y-4">
        <span class="lemonade-badge bg-white/70">How it works</span>
        <h2>Install it like an app or use it right in the browser</h2>
        <p class="lemonade-section__lead">Families can open the live version on any device, then add it to the home screen for a cleaner full-screen experience. That keeps the curriculum close at hand when it is time to plan, budget, or practice the pitch.</p>
      </div>
      <div class="lemonade-steps">
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">📱</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">iPhone &amp; iPad (Safari)</h3>
            <p>Open the app, tap the share icon, then choose <strong>Add to Home Screen</strong> and confirm.</p>
          </div>
        </div>
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">🤖</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Android (Chrome)</h3>
            <p>Visit the site, tap the menu (three dots), select <strong>Install app</strong>, and follow the prompt to place it on your home screen.</p>
          </div>
        </div>
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">🖥️</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Desktop (Chrome or Edge)</h3>
            <p>Click the install icon in the address bar (a download or computer symbol) and choose <strong>Install</strong> to add a launcher to your desktop or start menu.</p>
          </div>
        </div>
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">🌐</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Browser friendly</h3>
            <p>No install required. The app works as a regular website if you want to preview it quickly or share it in a message.</p>
          </div>
        </div>
      </div>
    </section>

      <section class="lemonade-section" data-reveal>
      <div class="max-w-3xl space-y-4">
        <span class="lemonade-badge bg-white/70">Inside the kit</span>
        <h2>What is Lemonade Boss?</h2>
        <p class="lemonade-section__lead">Lemonade Boss is a youth entrepreneurship adventure. Kids map out their dream stand, test recipes, plan supplies, and try on new leadership roles while practicing money smarts and confidence.</p>
      </div>
      <div class="lemonade-grid">
        <article class="lemonade-card">
          <span class="lemonade-step__icon" aria-hidden="true">🎯</span>
          <h3>Dream &amp; design</h3>
          <p>Choose a theme, name the stand, and sketch out the customer experience before the first cup gets poured.</p>
        </article>
        <article class="lemonade-card">
          <span class="lemonade-step__icon" aria-hidden="true">📊</span>
          <h3>Budget like a boss</h3>
          <p>Track ingredients, supplies, and donations so pricing feels easy, fair, and age-appropriate.</p>
        </article>
        <article class="lemonade-card">
          <span class="lemonade-step__icon" aria-hidden="true">🗣️</span>
          <h3>Pitch &amp; promote</h3>
          <p>Write a mini business pitch, design signs, and practice inviting customers with confidence.</p>
        </article>
        <article class="lemonade-card">
          <span class="lemonade-step__icon" aria-hidden="true">💛</span>
          <h3>Serve with heart</h3>
          <p>Use cue cards to greet guests, talk about Guard family life, and celebrate the win together.</p>
        </article>
      </div>
    </section>

      <section class="lemonade-section green" data-reveal>
      <div class="max-w-3xl space-y-4">
        <span class="lemonade-badge bg-white/70">Workbook</span>
        <h2>What's inside the workbook?</h2>
        <p class="lemonade-section__lead">The downloadable PDF bundles everything families need. It keeps prep low and makes it easy for parents to sit down with their kids and run the activity without building materials from scratch.</p>
      </div>
      <div class="lemonade-grid">
        <article class="lemonade-card">
          <h3>Start-up planner</h3>
          <ul>
            <li>Goal setting &amp; stand theme brainstorms</li>
            <li>Menu mix-and-match worksheets</li>
            <li>Shopping checklist with cost estimates</li>
          </ul>
        </article>
        <article class="lemonade-card">
          <h3>Money smart tools</h3>
          <ul>
            <li>Pricing calculator &amp; breakeven chart</li>
            <li>Daily sales tracker &amp; reflection prompts</li>
            <li>Give-back ideas for the final profits</li>
          </ul>
        </article>
        <article class="lemonade-card">
          <h3>Marketing kit</h3>
          <ul>
            <li>Poster templates &amp; social blurbs</li>
            <li>Thank-you notes for partners</li>
            <li>Photo checklist to capture the day</li>
          </ul>
        </article>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class="lemonade-btn lemonade-btn--primary" href="/assets/files/Lemonade_Boss_Workbook.pdf" target="_blank" rel="noopener">Download Lemonade Boss PDF</a>
        <a class="lemonade-btn lemonade-btn--secondary" href="{{ site.links.lemonadeBossApp }}" target="_blank" rel="noopener">Launch the digital kit</a>
      </div>
    </section>

      <section class="lemonade-section sunny" data-reveal>
      <div class="max-w-3xl space-y-4">
        <span class="lemonade-badge bg-white/70">Facilitator tips</span>
        <h2>How to make the update shine</h2>
        <p class="lemonade-section__lead">Whether you're a CYP coordinator, volunteer, or parent champion, these simple habits make the activity feel polished and easy to run.</p>
      </div>
      <div class="lemonade-steps">
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">⏱️</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Plan short sprints</h3>
            <p>Three 45-minute meetups keep momentum: Plan, prep, and celebrate.</p>
          </div>
        </div>
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">🤝</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Invite community partners</h3>
            <p>Local grocers love donating lemons. Banks and credit unions often sponsor supplies.</p>
          </div>
        </div>
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">📸</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Capture the story</h3>
            <p>Take photos, gather quotes, and share wins with Guard leaders and sponsors.</p>
          </div>
        </div>
        <div class="lemonade-step">
          <span class="lemonade-step__icon" aria-hidden="true">🎉</span>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Celebrate generosity</h3>
            <p>Close with a gratitude circle so youth can shout out teammates and supporters.</p>
          </div>
        </div>
      </div>
    </section>

      <section class="lemonade-footer" data-reveal>
        <h2>Need help launching your stand?</h2>
        <p>We're happy to coach facilitators, ship starter kits, or line up guest mentors. Email us at <a class="underline decoration-dotted text-white hover:text-primary" href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a> and mention "Lemonade Boss."</p>
      </section>
    </div>
  </div>
</div>
