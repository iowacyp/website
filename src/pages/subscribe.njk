---
layout: layouts/base.njk
title: Join the Iowa CYP List | Event & Program Updates
description: Sign up to receive Iowa CYP program announcements, camp registration alerts, and family resources in your inbox.
permalink: /subscribe/index.html
---
<section class="relative isolate overflow-hidden" data-reveal>
  <div class="absolute inset-0">
    <img
      src="/assets/img/programs/family_events_fall_festival.jpg"
      alt="Families gathered at an Iowa CYP fall festival"
      class="absolute inset-0 h-full w-full object-cover object-[center_35%] brightness-75 saturate-90 contrast-110"
      loading="lazy"
      decoding="async"
    >
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/94 via-slate-950/82 to-slate-950/60"></div>
  <div class="relative container min-h-[55vh] py-20 flex items-center">
    <div class="max-w-3xl rounded-[2rem] border border-white/10 bg-slate-950/88 p-6 md:p-10 text-white space-y-6 shadow-2xl backdrop-blur-md">
      <p class="text-sm uppercase tracking-[0.15em] text-secondary">Stay in the loop</p>
      <h1 class="text-3xl md:text-4xl font-semibold text-white">Join the Iowa CYP email list</h1>
      <p class="text-white/95 text-base md:text-lg leading-relaxed">Be first to know when camp registration opens, when adventure kits ship, and when partner events are coming to your area.</p>
    </div>
  </div>
</section>

<section class="bg-white py-16" data-reveal>
  <div class="container max-w-3xl space-y-12">
    <div class="space-y-4 text-center">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">What you can expect</p>
      <p class="text-slate-700 leading-relaxed">Monthly roundups with registration reminders, statewide resource updates, and a look at upcoming programming. We also send urgent alerts when spots are limited.</p>
    </div>
    {% set formId = 'subscribeForm' %}
    {% set statusId = 'subscribeStatus' %}
    {% set submitLabel = 'Submit' %}
    {% set submitDataAttr = 'data-subscribe-submit' %}
    {% set sourceValue = 'www.iowacyp.com' %}
    {% set tagsValue = 'website-subscribe' %}
    {% include "partials/subscribe-form-fields.njk" %}
  </div>
</section>

<section class="container pb-20" data-reveal>
  <div class="content-card md:flex md:items-center md:justify-between md:gap-8 space-y-6 md:space-y-0">
    <div class="space-y-3">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Need to update your info?</p>
      <p class="text-gray-700 leading-relaxed">Email us any time with changes to your contact details or subscription preferences, and we’ll make sure you keep getting the updates you want.</p>
    </div>
    <a class="btn-secondary" href="mailto:{{ site.contactEmail }}?subject=Update%20Preferences">Email the CYP team</a>
  </div>
</section>
