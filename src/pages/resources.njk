---
layout: layouts/base.njk
title: Iowa National Guard Family Resources | Iowa CYP
description: Find scholarships, counseling, childcare, deployment help, tutoring, and other trusted resources for Iowa National Guard children and families.
permalink: /resources/index.html
---
<section class="relative isolate overflow-hidden" data-reveal>
  <div class="absolute inset-0">
    <img
      src="/assets/img/resources/teaching.jpg"
      alt="Iowa CYP team member guiding a Guard-connected student through a workshop"
      class="absolute inset-0 h-full w-full object-cover object-[center_35%] brightness-75 saturate-90 contrast-110"
      {{ imageAttrs('/assets/img/resources/teaching.jpg') }}
      loading="lazy"
      decoding="async"
    >
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/94 via-slate-950/82 to-slate-950/60"></div>
  <div class="relative container min-h-[48vh] py-16 md:py-20 flex items-center">
    <div class="max-w-3xl rounded-[2rem] border border-white/10 bg-slate-950/88 p-6 md:p-8 text-white space-y-5 shadow-2xl backdrop-blur-md">
      <p class="text-sm uppercase tracking-[0.15em] text-secondary">Resource Hub</p>
      <h1 class="text-3xl md:text-4xl font-semibold text-white">Quick support for Guard-connected kids, teens, and caregivers</h1>
      <p class="text-white/95 text-base md:text-lg leading-relaxed">Start with what your family needs today. This directory grows with family feedback, so it stays useful when life changes.</p>
      <a class="btn-secondary w-fit" href="#resource-directory">Find support</a>
    </div>
  </div>
</section>

<section id="top-resources" class="bg-white py-12 md:py-16" data-reveal>
  <div class="container space-y-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl space-y-3">
        <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Resource directory</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Find the kind of support you need</h2>
        <p class="text-slate-700 leading-relaxed">Browse a short, practical list of trusted partners by what matters most to your family right now.</p>
      </div>
      <a class="text-sm font-semibold text-primary inline-flex items-center gap-2 whitespace-nowrap" href="#resource-contact">Can’t find it?<span aria-hidden="true">&rarr;</span></a>
    </div>
    <nav class="flex flex-wrap gap-2" aria-label="Resource topics">
      <a class="resource-topic" href="#education-planning-r001">Education &amp; planning</a>
      <a class="resource-topic" href="#child-care-r008">Child care</a>
      <a class="resource-topic" href="#family-support-r005">Family support</a>
      <a class="resource-topic" href="#guard-connection-r002">Guard connection</a>
      <a class="resource-topic" href="#youth-activities-r007">Youth activities</a>
      <a class="resource-topic" href="#wellness-r009">Wellness</a>
      <a class="resource-topic" href="#crisis-safety-r014">Crisis &amp; safety</a>
    </nav>
    <div id="resource-directory" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {% for resource in resources.items %}
        <article id="{% if resource.category %}{{ resource.category | lower | replace(' & ', '-') | replace(' ', '-') }}{% else %}resource{% endif %}-{{ resource.id | lower }}" class="resource-directory-card flex gap-3 h-full" data-reveal>
          {% if resource.image %}
            <img
              src="{{ resource.image }}"
              alt=""
              class="h-14 w-14 flex-shrink-0 object-contain rounded-xl border border-slate-200 bg-white"
              data-resource-logo
              data-resource-text="{{ (resource.label ~ ' ' ~ resource.summary) | escape }}"
              {{ imageAttrs(resource.image) }}
              loading="lazy"
              decoding="async"
            >
          {% else %}
            <span class="resource-initials" aria-hidden="true">{{ resource.label | truncate(2, true, '') }}</span>
          {% endif %}
          <div class="min-w-0 space-y-2">
            {% if resource.category %}<p class="text-[0.68rem] font-semibold uppercase tracking-[0.13em] text-primary/70">{{ resource.category }}</p>{% endif %}
            <h3 class="text-base font-semibold text-slate-900 leading-snug">
              <a href="{{ resource.url }}" target="_blank" rel="noopener">{{ resource.label }}</a>
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed">{{ resource.summary }}</p>
            <a class="text-sm font-semibold text-primary inline-flex items-center gap-2" href="{{ resource.url }}"{% if resource.url | slice(0, 1) != '/' %} target="_blank" rel="noopener"{% endif %}>Visit resource<span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="scholarships" class="bg-primary/5 py-10 md:py-12" data-reveal>
  <div class="container">
    <div class="rounded-3xl border border-primary/15 bg-white p-6 md:flex md:items-center md:justify-between md:gap-8">
      <div class="space-y-2 max-w-3xl">
        <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Scholarships &amp; grants</p>
        <h2 class="text-xl md:text-2xl font-semibold text-slate-900">Planning for what’s next?</h2>
        <p class="text-sm text-slate-700 leading-relaxed">Browse funding options for Guard-connected students pursuing college, trade school, or certification programs.</p>
      </div>
      <a class="btn mt-5 md:mt-0 shrink-0" href="{{ resources.items[0].url }}" target="_blank" rel="noopener">Open database</a>
    </div>
  </div>
</section>

<section id="downloads" class="bg-white py-12 md:py-16" data-reveal>
  <div class="container space-y-10">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Downloadable guides</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Share-ready flyers, checklists, and talking points</h2>
      <p class="text-slate-700 leading-relaxed">Send these PDFs to families, school staff, or partners when you want to spread the word about upcoming opportunities and year-round support.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {% for download in downloads.items %}
        <article class="content-card flex flex-col gap-4 h-full" data-reveal>
          {% if download.thumbnails %}
            <div class="grid gap-3{% if download.thumbnails | length > 1 %} sm:grid-cols-2{% endif %}">
              {% for thumb in download.thumbnails %}
                <img
                  src="{{ thumb }}"
                  alt="{{ download.title }} preview {{ loop.index }}"
                  class="max-h-44 w-full object-contain rounded-2xl border border-slate-200 bg-white p-2"
                  {{ imageAttrs(thumb) }}
                  loading="lazy"
                  decoding="async"
                >
              {% endfor %}
            </div>
          {% endif %}
          <div class="space-y-3">
            <h3 class="text-lg font-semibold text-slate-900">{{ download.title }}</h3>
            <p class="text-sm text-gray-700 leading-relaxed">{{ download.description }}</p>
          </div>
          <a class="btn-secondary w-fit mt-auto" href="{{ download.file }}" target="_blank" rel="noopener">Download</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="resource-contact" class="container pt-12 pb-16" data-reveal>
  <div class="content-card md:flex md:items-center md:justify-between md:gap-8 space-y-6 md:space-y-0">
    <div class="space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Need something else?</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">What would make life easier right now?</h2>
      <p class="text-gray-700 leading-relaxed">Tell us what your family is looking for. We’ll help find the right connection and use your feedback to grow this directory.</p>
    </div>
    <a class="btn" href="mailto:iaarngcyp@gmail.com?subject=Resource%20request">Request a resource</a>
  </div>
</section>
