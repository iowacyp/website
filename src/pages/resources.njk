---
layout: layouts/base.njk
title: Iowa National Guard Family Resources | Iowa CYP
description: Find scholarships, counseling, childcare, deployment help, tutoring, and other trusted resources for Iowa National Guard children and families.
permalink: /resources/index.html
---
<section class="relative isolate overflow-hidden" data-reveal>
  <div class="absolute inset-0">
    <img
      src="/assets/img/resources/teaching.jpg"
      alt="Iowa CYP team member guiding a Guard-connected student through a workshop"
      class="absolute inset-0 h-full w-full object-cover object-[center_35%] brightness-75 saturate-90 contrast-110"
      {{ imageAttrs('/assets/img/resources/teaching.jpg') }}
      loading="lazy"
      decoding="async"
    >
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/94 via-slate-950/82 to-slate-950/60"></div>
  <div class="relative container min-h-[48vh] py-16 md:py-20 flex items-center justify-center">
    <div class="max-w-3xl rounded-[2rem] border border-white/10 bg-slate-950/88 p-6 md:p-8 text-white space-y-5 text-center shadow-2xl backdrop-blur-md">
      <p class="text-sm uppercase tracking-[0.15em] text-secondary">Resource Hub</p>
      <h1 class="text-3xl md:text-4xl font-semibold text-white">Support for Guard families</h1>
      <p class="text-white/95 text-base md:text-lg leading-relaxed">Find tutoring, deployment support, activities for kids, or help planning for school after graduation.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="btn-secondary w-fit" href="#cyp-programs">Iowa CYP programs</a>
        <a class="w-fit inline-flex items-center rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10" href="#resource-directory">Browse all resources</a>
      </div>
    </div>
  </div>
</section>

{% set virtualItems = [] %}
{% set partnerItems = [] %}
{% for resource in resources.items %}
  {% if resource.section == 'cyp' %}
    {% set virtualItems = (virtualItems.push(resource), virtualItems) %}
  {% else %}
    {% set partnerItems = (partnerItems.push(resource), partnerItems) %}
  {% endif %}
{% endfor %}
{% set categoryOrder = ['Crisis & safety', 'Education & planning', 'Child care', 'Family support', 'Guard connection', 'Youth activities', 'Wellness'] %}

<section id="cyp-programs" class="bg-primary/5 py-12 md:py-16" data-reveal>
  <div class="container space-y-8">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Iowa CYP programs</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Programs built by Iowa CYP for Guard families</h2>
      <p class="text-slate-700 leading-relaxed">Virtual programs you can open from anywhere, plus in-person and classroom programs across Iowa. New programs are added as they launch.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {% for program in virtualItems %}
        {% set isComingSoon = program.status == 'coming-soon' or not program.url %}
        <article id="virtual-{{ program.id | lower }}" class="virtual-program-card{% if isComingSoon %} virtual-program-card--soon{% endif %}" data-reveal>
          <div class="virtual-program-card__media">
            {% if program.image %}
              <img
                src="{{ program.image }}"
                alt=""
                class="h-full w-full object-cover"
                {{ imageAttrs(program.image) }}
                loading="lazy"
                decoding="async"
              >
            {% else %}
              <div class="flex h-full w-full items-center justify-center bg-primary/10 text-primary" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.2 2.8 8.1 7 10 4.2-1.9 7-5.8 7-10V6l-7-3Z"/><path d="M9 11a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z"/><path d="M7.5 17a4.5 4.5 0 0 1 9 0"/></svg>
              </div>
            {% endif %}
            <span class="virtual-program-badge virtual-program-badge--{{ program.status }}">{{ program.statusLabel or 'Available now' }}</span>
            {% if program.delivery %}<span class="virtual-program-delivery">{{ program.delivery }}</span>{% endif %}
          </div>
          <div class="flex flex-1 flex-col gap-3 p-5">
            <h3 class="text-lg font-semibold text-slate-900 leading-snug">{{ program.label }}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{{ program.summary }}</p>
            {% if program.audience %}
              <p class="text-xs text-slate-500">For: {{ program.audience | join(', ') }}</p>
            {% endif %}
            {% if isComingSoon %}
              <a class="btn-secondary w-fit mt-auto" href="mailto:iaarngcyp@gmail.com?subject=Notify%20me%3A%20{{ program.label | urlencode }}">{{ program.cta or 'Get notified' }}</a>
            {% else %}
              <a class="btn w-fit mt-auto" href="{{ program.url }}"{% if not (program.url.startsWith('/') or program.url.startsWith('mailto:')) %} target="_blank" rel="noopener"{% endif %}>{{ program.cta or 'Open' }}</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="top-resources" class="bg-white py-12 md:py-16" data-reveal>
  <div class="container space-y-8" data-resource-filter>
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl space-y-3">
        <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Partner &amp; community resources</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Find the kind of support you need</h2>
        <p class="text-slate-700 leading-relaxed">Choose a topic, filter by who needs help, or search for a resource by name.</p>
      </div>
      <a class="text-sm font-semibold text-primary inline-flex items-center gap-2 whitespace-nowrap" href="#resource-contact">Can’t find it?<span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="space-y-4">
      <label class="block max-w-md">
        <span class="sr-only">Search resources</span>
        <input type="search" data-resource-search placeholder="Search resources (e.g. tutoring, child care, crisis)" class="w-full rounded-full border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30" autocomplete="off">
      </label>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by topic">
        <button type="button" class="resource-topic is-active" data-filter-category="all" aria-pressed="true">All topics <span class="resource-topic__count">{{ partnerItems | length }}</span></button>
        {% for cat in categoryOrder %}
          {% set count = 0 %}
          {% for r in partnerItems %}{% if r.category == cat %}{% set count = count + 1 %}{% endif %}{% endfor %}
          {% if count > 0 %}
            <button type="button" class="resource-topic" data-filter-category="{{ cat }}" aria-pressed="false">{{ cat }} <span class="resource-topic__count">{{ count }}</span></button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by who it's for">
        <span class="text-xs font-semibold uppercase tracking-[0.13em] text-slate-500 mr-1">For</span>
        <button type="button" class="resource-topic resource-topic--small is-active" data-filter-audience="all" aria-pressed="true">Everyone</button>
        <button type="button" class="resource-topic resource-topic--small" data-filter-audience="kids" aria-pressed="false">Kids</button>
        <button type="button" class="resource-topic resource-topic--small" data-filter-audience="teens" aria-pressed="false">Teens</button>
        <button type="button" class="resource-topic resource-topic--small" data-filter-audience="caregivers" aria-pressed="false">Parents &amp; caregivers</button>
      </div>
      <p class="text-sm text-slate-600" data-resource-status aria-live="polite">Showing all {{ partnerItems | length }} resources</p>
    </div>

    <div id="resource-directory" class="space-y-10">
      {% for cat in categoryOrder %}
        {% set groupItems = [] %}
        {% for r in partnerItems %}{% if r.category == cat %}{% set groupItems = (groupItems.push(r), groupItems) %}{% endif %}{% endfor %}
        {% if groupItems | length %}
          <div class="space-y-4" data-resource-group="{{ cat }}" id="{{ cat | lower | replace(' & ', '-') | replace(' ', '-') }}">
            <h3 class="text-lg font-semibold text-slate-900 border-b border-slate-200 pb-2">{{ cat }}</h3>
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {% for resource in groupItems %}
                <article
                  id="{{ cat | lower | replace(' & ', '-') | replace(' ', '-') }}-{{ resource.id | lower }}"
                  class="resource-directory-card flex gap-3 h-full"
                  data-resource-item
                  data-category="{{ resource.category }}"
                  data-audience="{{ resource.audience | join(' ') }}"
                  data-search="{{ (resource.label ~ ' ' ~ resource.summary ~ ' ' ~ resource.category ~ ' ' ~ (resource.format or '')) | lower | escape }}"
                  data-reveal
                >
                  {% if resource.image %}
                    <img
                      src="{{ resource.image }}"
                      alt=""
                      class="h-14 w-14 flex-shrink-0 object-contain rounded-xl border border-slate-200 bg-white"
                      data-resource-logo
                      data-resource-text="{{ (resource.label ~ ' ' ~ resource.summary) | escape }}"
                      {{ imageAttrs(resource.image) }}
                      loading="lazy"
                      decoding="async"
                    >
                  {% else %}
                    <span class="resource-initials" aria-hidden="true">{{ resource.label | truncate(2, true, '') }}</span>
                  {% endif %}
                  <div class="min-w-0 space-y-2">
                    {% if resource.format %}<p class="text-[0.68rem] font-semibold uppercase tracking-[0.13em] text-primary/70">{{ resource.format }}</p>{% endif %}
                    <h3 class="text-base font-semibold text-slate-900 leading-snug">
                      <a href="{{ resource.url }}"{% if not resource.url.startsWith('/') %} target="_blank" rel="noopener"{% endif %}>{{ resource.label }}</a>
                    </h3>
                    <p class="text-sm text-gray-700 leading-relaxed">{{ resource.summary }}</p>
                    <a class="text-sm font-semibold text-primary inline-flex items-center gap-2" href="{{ resource.url }}"{% if not resource.url.startsWith('/') %} target="_blank" rel="noopener"{% endif %}>Visit resource<span aria-hidden="true">&rarr;</span></a>
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
      <p class="hidden rounded-2xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-600" data-resource-empty>No resources match yet. Try a different topic, or <a class="font-semibold text-primary" href="#resource-contact">tell us what you need</a>.</p>
    </div>
  </div>
</section>

<section id="scholarships" class="bg-primary/5 py-10 md:py-12" data-reveal>
  <div class="container">
    <div class="rounded-3xl border border-primary/15 bg-white p-6 md:flex md:items-center md:justify-between md:gap-8">
      <div class="space-y-2 max-w-3xl">
        <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Scholarships &amp; grants</p>
        <h2 class="text-xl md:text-2xl font-semibold text-slate-900">Paying for school or training</h2>
        <p class="text-sm text-slate-700 leading-relaxed">Browse funding options for Guard-connected students pursuing college, trade school, or certification programs.</p>
      </div>
      <a class="btn mt-5 md:mt-0 shrink-0" href="{{ resources.items[0].url }}" target="_blank" rel="noopener">Open database</a>
    </div>
  </div>
</section>

<section id="downloads" class="bg-white py-12 md:py-16" data-reveal>
  <div class="container space-y-10">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Downloadable guides</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Share-ready flyers, checklists, and talking points</h2>
      <p class="text-slate-700 leading-relaxed">Send these PDFs to families, school staff, or partners when you want to spread the word about upcoming opportunities and year-round support.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {% for download in downloads.items %}
        <article class="content-card flex flex-col gap-4 h-full" data-reveal>
          {% if download.thumbnails %}
            <div class="grid gap-3{% if download.thumbnails | length > 1 %} sm:grid-cols-2{% endif %}">
              {% for thumb in download.thumbnails %}
                <img
                  src="{{ thumb }}"
                  alt="{{ download.title }} preview {{ loop.index }}"
                  class="max-h-44 w-full object-contain rounded-2xl border border-slate-200 bg-white p-2"
                  {{ imageAttrs(thumb) }}
                  loading="lazy"
                  decoding="async"
                >
              {% endfor %}
            </div>
          {% endif %}
          <div class="space-y-3">
            <h3 class="text-lg font-semibold text-slate-900">{{ download.title }}</h3>
            <p class="text-sm text-gray-700 leading-relaxed">{{ download.description }}</p>
          </div>
          <a class="btn-secondary w-fit mt-auto" href="{{ download.file }}" target="_blank" rel="noopener">Download</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="resource-contact" class="container pt-12 pb-16" data-reveal>
  <div class="content-card md:flex md:items-center md:justify-between md:gap-8 space-y-6 md:space-y-0">
    <div class="space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Need something else?</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">What would make life easier right now?</h2>
      <p class="text-gray-700 leading-relaxed">Tell us what your family is looking for. We’ll help find the right connection and use your feedback to grow this directory.</p>
    </div>
    <a class="btn" href="mailto:iaarngcyp@gmail.com?subject=Resource%20request">Request a resource</a>
  </div>
</section>
