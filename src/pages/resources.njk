---
layout: layouts/base.njk
title: Resources for Military Families | Iowa CYP
description: Quick links to scholarships, counseling, childcare, and support resources for Iowa National Guard children, teens, and families.
permalink: /resources/index.html
---
<section class="relative isolate overflow-hidden" data-reveal>
  <div class="absolute inset-0">
    <img
      src="/assets/img/resources/teaching.jpg"
      alt="Iowa CYP team member guiding a Guard-connected student through a workshop"
      class="absolute inset-0 h-full w-full object-cover object-[center_35%] brightness-75 saturate-90 contrast-110"
      {{ imageAttrs('/assets/img/resources/teaching.jpg') }}
      loading="lazy"
      decoding="async"
    >
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/94 via-slate-950/82 to-slate-950/60"></div>
  <div class="relative container min-h-[60vh] py-24 flex items-center">
    <div class="max-w-3xl rounded-[2rem] border border-white/10 bg-slate-950/88 p-6 md:p-10 text-white space-y-6 shadow-2xl backdrop-blur-md">
      <p class="text-sm uppercase tracking-[0.15em] text-secondary">Resource Hub</p>
      <h1 class="text-3xl md:text-4xl font-semibold text-white">Quick support for Guard-connected kids, teens, and caregivers</h1>
      <p class="text-white/95 text-base md:text-lg leading-relaxed">Need a quick answer or steady support? These links point to the partners Guard-connected families lean on most.</p>
    </div>
  </div>
</section>

<section id="top-resources" class="bg-white py-16" data-reveal>
  <div class="container space-y-12">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Top resources</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Trusted partners families call first</h2>
      <p class="text-slate-700 leading-relaxed">Browse by topic—from deployment prep to tutoring—and find the help that fits your family right now.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {% for resource in resources.items %}
        <article id="resource-{{ resource.id | lower }}" class="content-card flex gap-4 h-full" data-reveal>
          {% if resource.image %}
            <img
              src="{{ resource.image }}"
              alt=""
              class="h-14 w-14 flex-shrink-0 object-contain rounded-xl border border-slate-200 bg-white"
              data-resource-logo
              data-resource-text="{{ (resource.label ~ ' ' ~ resource.summary) | escape }}"
              {{ imageAttrs(resource.image) }}
              loading="lazy"
              decoding="async"
            >
          {% endif %}
          <div class="space-y-2">
            <h3 class="text-lg font-semibold text-slate-900">
              <a href="{{ resource.url }}" target="_blank" rel="noopener">{{ resource.label }}</a>
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed">{{ resource.summary }}</p>
            <a class="text-sm font-semibold text-primary inline-flex items-center gap-2" href="{{ resource.url }}" target="_blank" rel="noopener">Open resource<span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="scholarships" class="bg-primary/5 py-20" data-reveal>
  <div class="container space-y-10">
    <article class="content-card grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-center" data-reveal>
      <div class="space-y-4">
        <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Scholarships &amp; grants</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Funding pathways for military-connected students</h2>
        <p class="text-gray-700 leading-relaxed">We keep track of scholarships and grants for Guard-connected students heading to college, trade schools, or certification programs. Share the database with families so they can spot the opportunities that fit best.</p>
        {% if site.links.scholarshipDatabase %}
          <a class="btn" href="{{ site.links.scholarshipDatabase }}" target="_blank" rel="noopener">Open the scholarship database</a>
        {% else %}
          <p class="text-sm text-gray-700">Scholarship database link coming soon. <a class="text-primary font-semibold" href="mailto:{{ site.contactEmail }}?subject=Scholarship%20Database%20Request">Email us to request the latest spreadsheet.</a></p>
        {% endif %}
      </div>
        <div class="overflow-hidden rounded-[2.5rem] border border-primary/15 shadow-sm max-h-[420px]">
        <img
          src="/assets/img/resources/leadership.jpg"
          alt="Guard-connected youth gathered for a leadership workshop"
          class="w-full h-full object-cover"
          {{ imageAttrs('/assets/img/resources/leadership.jpg') }}
          loading="lazy"
          decoding="async"
        >
      </div>
    </article>
  </div>
</section>

<section id="downloads" class="bg-white py-16" data-reveal>
  <div class="container space-y-10">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Downloadable guides</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Share-ready flyers, checklists, and talking points</h2>
      <p class="text-slate-700 leading-relaxed">Send these PDFs to families, school staff, or partners when you want to spread the word about upcoming opportunities and year-round support.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {% for download in downloads.items %}
        <article class="content-card flex flex-col gap-4 h-full" data-reveal>
          {% if download.thumbnails %}
            <div class="grid gap-3{% if download.thumbnails | length > 1 %} sm:grid-cols-2{% endif %}">
              {% for thumb in download.thumbnails %}
                <img
                  src="{{ thumb }}"
                  alt="{{ download.title }} preview {{ loop.index }}"
                  class="max-h-44 w-full object-contain rounded-2xl border border-slate-200 bg-white p-2"
                  {{ imageAttrs(thumb) }}
                  loading="lazy"
                  decoding="async"
                >
              {% endfor %}
            </div>
          {% endif %}
          <div class="space-y-3">
            <h3 class="text-lg font-semibold text-slate-900">{{ download.title }}</h3>
            <p class="text-sm text-gray-700 leading-relaxed">{{ download.description }}</p>
          </div>
          <a class="btn-secondary w-fit mt-auto" href="{{ download.file }}" target="_blank" rel="noopener">Download</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="resource-contact" class="container pt-16 pb-20" data-reveal>
  <div class="content-card md:flex md:items-center md:justify-between md:gap-8 space-y-6 md:space-y-0">
    <div class="space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Need something else?</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Tell us what support you wish existed</h2>
      <p class="text-gray-700 leading-relaxed">We’ll connect you with the right teammate or build a new tool if there’s a gap.</p>
    </div>
    <a class="btn" href="mailto:iaarngcyp@gmail.com">Email the team</a>
  </div>
</section>
