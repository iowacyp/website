---
permalink: /stp-application/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>State Teen Panel - Member Application</title>
    <meta
      name="description"
      content="Iowa National Guard Child & Youth Program State Teen Panel application form."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --gold: #b8930a;
        --gold-dark: #8e7208;
        --ink: #1a1a1a;
        --bg: #f9f9f9;
        --paper: #ffffff;
        --paper-soft: #fcfbf7;
        --line: #d9d1bf;
        --line-soft: #ebe6d8;
        --muted: #606060;
        --text: #202020;
        --error: #b42318;
        --error-bg: #fff5f5;
        --success-bg: #fff9e8;
        --success-line: #ceb14b;
        --focus: rgba(184, 147, 10, 0.28);
        --shadow: 0 20px 60px rgba(26, 26, 26, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Inter, Calibri, Arial, sans-serif;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(249, 249, 249, 1) 34%),
          var(--bg);
        color: var(--text);
        line-height: 1.5;
      }

      .app {
        width: min(1100px, calc(100% - 32px));
        margin: 0 auto;
        padding: 24px 0 48px;
      }

      .banner {
        display: none;
        border: 2px solid var(--success-line);
        background: var(--success-bg);
        color: var(--ink);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 18px;
        box-shadow: 0 10px 30px rgba(184, 147, 10, 0.14);
      }

      .banner.is-visible {
        display: block;
      }

      .banner.is-error {
        border-color: #d92d20;
        background: #fff5f5;
        color: #7a271a;
      }

      .banner strong {
        display: block;
        margin-bottom: 2px;
      }

      .hero {
        padding: 8px 0 18px;
        margin-bottom: 16px;
      }

      .eyebrow {
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 10px;
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1.05;
        color: var(--ink);
        font-weight: 800;
        max-width: 14ch;
      }

      .title-accent {
        width: 120px;
        height: 5px;
        background: var(--gold);
        border-radius: 999px;
        margin-top: 14px;
      }

      .subheader {
        margin: 12px 0 0;
        color: var(--muted);
        font-size: 1rem;
        max-width: 50ch;
      }

      .card {
        background: var(--paper);
        border: 1px solid var(--line-soft);
        border-radius: 20px;
        box-shadow: var(--shadow);
        overflow: clip;
      }

      .gate {
        margin-bottom: 18px;
      }

      .gate-body {
        padding: 18px;
      }

      .section-bar {
        background: var(--gold);
        color: #fff;
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 12px 18px;
      }

      .section-copy {
        padding: 18px 18px 6px;
      }

      .section-copy p {
        margin: 0 0 10px;
        color: var(--muted);
      }

      .checklist {
        display: grid;
        gap: 12px;
        margin-top: 14px;
      }

      .check-row {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 14px;
        border: 1px solid var(--line-soft);
        border-radius: 14px;
        background: var(--paper-soft);
      }

      .check-row input {
        margin-top: 3px;
        width: 18px;
        height: 18px;
        accent-color: var(--gold);
        flex: none;
      }

      .check-row label {
        display: block;
        font-size: 0.98rem;
        color: var(--text);
      }

      .gate-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-top: 16px;
      }

      .button {
        appearance: none;
        border: 1px solid transparent;
        border-radius: 999px;
        padding: 12px 18px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition:
          transform 0.15s ease,
          box-shadow 0.15s ease,
          background-color 0.15s ease,
          border-color 0.15s ease,
          color 0.15s ease;
      }

      .button:disabled {
        opacity: 0.56;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      .button-primary {
        background: var(--gold);
        color: #fff;
        box-shadow: 0 10px 18px rgba(184, 147, 10, 0.24);
      }

      .button-primary:not(:disabled):hover,
      .button-primary:not(:disabled):focus-visible {
        background: var(--gold-dark);
        box-shadow: 0 14px 22px rgba(184, 147, 10, 0.28);
      }

      .button-secondary {
        background: #fff;
        color: var(--ink);
        border-color: var(--line);
      }

      .button-secondary:not(:disabled):hover,
      .button-secondary:not(:disabled):focus-visible {
        border-color: var(--gold);
        box-shadow: 0 0 0 4px var(--focus);
      }

      .form-shell {
        display: none;
        gap: 18px;
      }

      .form-shell.is-visible {
        display: grid;
      }

      form {
        display: grid;
        gap: 18px;
      }

      .notice {
        border-radius: 14px;
        padding: 14px 16px;
        border: 1px solid var(--line-soft);
        background: #fff;
      }

      .notice.is-warning {
        border-color: #ecd9a1;
        background: #fffaf0;
      }

      .notice strong {
        display: block;
        margin-bottom: 2px;
      }

      .grid-2 {
        display: grid;
        gap: 14px;
      }

      .grid-3 {
        display: grid;
        gap: 14px;
      }

      .field {
        display: grid;
        gap: 8px;
      }

      .field label,
      .field legend {
        display: block;
        font-weight: 700;
        color: var(--ink);
      }

      .field legend {
        margin: 0;
        padding: 0;
      }

      .field small {
        color: var(--muted);
        font-weight: 500;
      }

      .control,
      select,
      textarea {
        width: 100%;
        border: 1px solid #cfc7b6;
        border-radius: 14px;
        background: #fff;
        color: var(--ink);
        font: inherit;
        padding: 13px 14px;
        transition:
          border-color 0.15s ease,
          box-shadow 0.15s ease,
          transform 0.15s ease;
      }

      textarea {
        min-height: 120px;
        resize: vertical;
      }

      .control:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 0 4px var(--focus);
      }

      .control::placeholder,
      textarea::placeholder {
        color: #8f8f8f;
      }

      .control[aria-invalid="true"],
      select[aria-invalid="true"],
      textarea[aria-invalid="true"] {
        border-color: var(--error);
        box-shadow: 0 0 0 4px rgba(180, 35, 24, 0.08);
      }

      .field-error {
        color: var(--error);
        font-size: 0.92rem;
        min-height: 1.1em;
      }

      .section {
        border: 1px solid var(--line-soft);
        border-radius: 18px;
        overflow: clip;
        background: #fff;
      }

      .section-body {
        padding: 18px;
        display: grid;
        gap: 16px;
      }

      .question-number {
        color: var(--gold);
        font-weight: 800;
      }

      .question-text {
        margin: 0;
        font-weight: 700;
        color: var(--ink);
      }

      .ack-list {
        display: grid;
        gap: 14px;
      }

      .ack-row {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 14px;
        border-radius: 14px;
        border: 1px solid var(--line-soft);
        background: #fcfcfb;
      }

      .ack-row input {
        margin-top: 3px;
        width: 18px;
        height: 18px;
        accent-color: var(--gold);
        flex: none;
      }

      .ack-row label {
        color: var(--text);
      }

      .fine-print {
        color: var(--muted);
        font-size: 0.94rem;
        margin: 0;
      }

      .submit-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        margin-top: 2px;
      }

      .submit-help {
        color: var(--muted);
        font-size: 0.93rem;
      }

      .footer {
        margin-top: 22px;
        padding: 18px 0 0;
        color: #4b4b4b;
        font-size: 0.92rem;
        white-space: pre-line;
      }

      .footer strong {
        color: var(--ink);
      }

      @media (min-width: 700px) {
        .gate-body,
        .section-body {
          padding: 22px;
        }

        .grid-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .grid-3 {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (min-width: 920px) {
        .app {
          width: min(1080px, calc(100% - 48px));
          padding-top: 30px;
        }

        h1 {
          max-width: none;
        }

        .section-body {
          padding: 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="app">
      <div id="successBanner" class="banner" role="status" aria-live="polite" hidden>
        <strong id="successBannerTitle">Application submitted</strong>
        <span id="successBannerText"></span>
      </div>

      <header class="hero">
        <p class="eyebrow">Iowa National Guard | Child & Youth Program</p>
        <h1>State Teen Panel - Member Application</h1>
        <div class="title-accent" aria-hidden="true"></div>
        <p class="subheader">
          Complete the eligibility check first, then fill out the application below. This page is designed for teens ages 13-17.
        </p>
      </header>

      <section class="card gate" aria-labelledby="eligibility-title">
        <div class="section-bar">Quick Check</div>
        <div class="gate-body">
          <h2 id="eligibility-title" class="question-text" style="font-size: 1.2rem;">Are you eligible?</h2>
          <div class="checklist" id="eligibilityChecklist">
            <div class="check-row">
              <input id="eligible-age" type="checkbox" />
              <label for="eligible-age">I am between 13 and 17 years old</label>
            </div>
            <div class="check-row">
              <input id="eligible-connected" type="checkbox" />
              <label for="eligible-connected">I am a military-connected youth (dependent, sibling, or stepchild of an Army National Guard Service Member)</label>
            </div>
            <div class="check-row">
              <input id="eligible-commit" type="checkbox" />
              <label for="eligible-commit">I am able to commit to events and meetings throughout the year</label>
            </div>
          </div>
          <div class="gate-actions">
            <button id="continueButton" class="button button-primary" type="button" disabled>
              Continue to Application
            </button>
            <button id="gateResetButton" class="button button-secondary" type="button">
              Clear
            </button>
          </div>
          <div
            id="eligibilityWarning"
            class="notice is-warning"
            role="status"
            aria-live="polite"
            hidden
            style="margin-top: 16px;"
          >
            <strong>Heads up</strong>
            You may not meet the eligibility requirements. Feel free to reach out to Chris Cox at
            <a href="mailto:christopher.j.cox18.ctr@army.mil">christopher.j.cox18.ctr@army.mil</a> with any questions.
          </div>
        </div>
      </section>

      <section id="applicationShell" class="form-shell" aria-labelledby="application-title">
        <div class="card">
          <div class="section-bar">Application Form</div>
          <div class="section-copy">
            <h2 id="application-title" class="question-text" style="font-size: 1.18rem; margin-bottom: 4px;">
              Tell us about yourself
            </h2>
            <p>All required fields are marked in the form. Please answer the application questions with as much detail as you can.</p>
          </div>
        </div>

        <form id="stpApplicationForm" novalidate>
          <section class="section" aria-labelledby="about-you-title">
            <div class="section-bar" id="about-you-title">Section I - About You</div>
            <div class="section-body">
              <div class="grid-2">
                <div class="field">
                  <label for="fullName">Full Name <small>(required)</small></label>
                  <input id="fullName" name="fullName" class="control" type="text" autocomplete="name" aria-required="true" />
                  <div class="field-error" id="fullName-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="age">Age <small>(required)</small></label>
                  <input id="age" name="age" class="control" type="number" min="13" max="17" inputmode="numeric" aria-required="true" />
                  <div class="field-error" id="age-error" aria-live="polite"></div>
                </div>
              </div>

              <div class="grid-3">
                <div class="field">
                  <label for="graduationYear">Graduation Year <small>(required)</small></label>
                  <select id="graduationYear" name="graduationYear" aria-required="true">
                    <option value="">Select one</option>
                    <option>2025</option>
                    <option>2026</option>
                    <option>2027</option>
                    <option>2028</option>
                    <option>2029</option>
                    <option>2030</option>
                    <option>2031</option>
                    <option>2032</option>
                  </select>
                  <div class="field-error" id="graduationYear-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="gender">Gender <small>(optional)</small></label>
                  <input id="gender" name="gender" class="control" type="text" placeholder="Optional" />
                  <div class="field-error" id="gender-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="tShirtSize">T-Shirt Size <small>(required)</small></label>
                  <select id="tShirtSize" name="tShirtSize" aria-required="true">
                    <option value="">Select one</option>
                    <option>S</option>
                    <option>M</option>
                    <option>L</option>
                    <option>XL</option>
                    <option>XXL</option>
                  </select>
                  <div class="field-error" id="tShirtSize-error" aria-live="polite"></div>
                </div>
              </div>

              <div class="field">
                <label for="mailingAddress">Mailing Address <small>(required)</small></label>
                <input id="mailingAddress" name="mailingAddress" class="control" type="text" autocomplete="street-address" aria-required="true" />
                <div class="field-error" id="mailingAddress-error" aria-live="polite"></div>
              </div>

              <div class="grid-3">
                <div class="field">
                  <label for="city">City <small>(required)</small></label>
                  <input id="city" name="city" class="control" type="text" autocomplete="address-level2" aria-required="true" />
                  <div class="field-error" id="city-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="zip">ZIP <small>(required)</small></label>
                  <input id="zip" name="zip" class="control" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" maxlength="5" aria-required="true" />
                  <div class="field-error" id="zip-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="cell">Cell # <small>(required)</small></label>
                  <input id="cell" name="cell" class="control" type="tel" autocomplete="tel" aria-required="true" />
                  <div class="field-error" id="cell-error" aria-live="polite"></div>
                </div>
              </div>

              <div class="grid-2">
                <div class="field">
                  <label for="email">Email <small>(required)</small></label>
                  <input id="email" name="email" class="control" type="email" autocomplete="email" aria-required="true" />
                  <div class="field-error" id="email-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="preferredContact">Preferred Contact Method <small>(optional)</small></label>
                  <input id="preferredContact" name="preferredContact" class="control" type="text" placeholder="Optional" />
                  <div class="field-error" id="preferredContact-error" aria-live="polite"></div>
                </div>
              </div>
            </div>
          </section>

          <section class="section" aria-labelledby="guardian-title">
            <div class="section-bar" id="guardian-title">Section II - Parent / Guardian</div>
            <div class="section-body">
              <div class="grid-2">
                <div class="field">
                  <label for="guardianName">Parent/Guardian Name <small>(required)</small></label>
                  <input id="guardianName" name="guardianName" class="control" type="text" autocomplete="name" aria-required="true" />
                  <div class="field-error" id="guardianName-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="relationship">Relationship to Applicant <small>(required)</small></label>
                  <input id="relationship" name="relationship" class="control" type="text" placeholder="e.g. Parent, Guardian, Stepparent" aria-required="true" />
                  <div class="field-error" id="relationship-error" aria-live="polite"></div>
                </div>
              </div>

              <div class="grid-3">
                <div class="field">
                  <label for="guardianCell">Cell Phone <small>(required)</small></label>
                  <input id="guardianCell" name="guardianCell" class="control" type="tel" autocomplete="tel" aria-required="true" />
                  <div class="field-error" id="guardianCell-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="guardianWorkPhone">Work Phone <small>(optional)</small></label>
                  <input id="guardianWorkPhone" name="guardianWorkPhone" class="control" type="tel" autocomplete="tel" />
                  <div class="field-error" id="guardianWorkPhone-error" aria-live="polite"></div>
                </div>
                <div class="field">
                  <label for="guardianEmail">Email <small>(required)</small></label>
                  <input id="guardianEmail" name="guardianEmail" class="control" type="email" autocomplete="email" aria-required="true" />
                  <div class="field-error" id="guardianEmail-error" aria-live="polite"></div>
                </div>
              </div>

              <div class="grid-2">
                <div class="field">
                  <label for="guardianName2">Parent/Guardian Name 2 <small>(optional)</small></label>
                  <input id="guardianName2" name="guardianName2" class="control" type="text" />
                  <div class="field-error" id="guardianName2-error" aria-live="polite"></div>
                </div>
                <div class="grid-2">
                  <div class="field">
                    <label for="guardianCell2">Cell Phone 2 <small>(optional)</small></label>
                    <input id="guardianCell2" name="guardianCell2" class="control" type="tel" />
                    <div class="field-error" id="guardianCell2-error" aria-live="polite"></div>
                  </div>
                  <div class="field">
                    <label for="guardianEmail2">Email 2 <small>(optional)</small></label>
                    <input id="guardianEmail2" name="guardianEmail2" class="control" type="email" />
                    <div class="field-error" id="guardianEmail2-error" aria-live="polite"></div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="section" aria-labelledby="application-questions-title">
            <div class="section-bar" id="application-questions-title">Section III - Your Application</div>
            <div class="section-body">
              <p class="fine-print">
                Answer each question in your own words. Each response box is intentionally large so you have room to explain.
              </p>

              <div class="field">
                <label for="q1"><span class="question-number">1.</span> What has your experience as a military-connected youth been like? Share what&apos;s shaped you.</label>
                <textarea id="q1" name="q1" aria-required="true"></textarea>
                <div class="field-error" id="q1-error" aria-live="polite"></div>
              </div>

              <div class="field">
                <label for="q2"><span class="question-number">2.</span> Who&apos;s a leader you look up to, and what makes them stand out to you?</label>
                <textarea id="q2" name="q2" aria-required="true"></textarea>
                <div class="field-error" id="q2-error" aria-live="polite"></div>
              </div>

              <div class="field">
                <label for="q3"><span class="question-number">3.</span> If you could dream about the impact of this program, what do you picture?</label>
                <textarea id="q3" name="q3" aria-required="true"></textarea>
                <div class="field-error" id="q3-error" aria-live="polite"></div>
              </div>

              <div class="field">
                <label for="q4"><span class="question-number">4.</span> What qualities do you think a good role model should have - and which of those do you already bring?</label>
                <textarea id="q4" name="q4" aria-required="true"></textarea>
                <div class="field-error" id="q4-error" aria-live="polite"></div>
              </div>

              <div class="field">
                <label for="q5"><span class="question-number">5.</span> Life gets busy! How do you plan to balance STP with school, sports, and everything else you&apos;ve got going on?</label>
                <textarea id="q5" name="q5" aria-required="true"></textarea>
                <div class="field-error" id="q5-error" aria-live="polite"></div>
              </div>
            </div>
          </section>

          <section class="section" aria-labelledby="ack-title">
            <div class="section-bar" id="ack-title">Section IV - Acknowledgements</div>
            <div class="section-body">
              <div class="ack-list">
                <div class="ack-row">
                  <input id="ackParent" name="ackParent" type="checkbox" aria-required="true" />
                  <label for="ackParent">
                    <strong>Parent/Guardian Permission:</strong>
                    I support my child&apos;s participation in the Iowa National Guard Child &amp; Youth Program State Teen Panel. I am willing to assist with transportation or ensure they can fulfill all responsibilities. I hold the Iowa Youth Program, its contractors, the Iowa National Guard, and program volunteers harmless from injury or death that may occur as a result of participation.
                  </label>
                </div>
                <div class="field-error" id="ackParent-error" aria-live="polite"></div>

                <div class="ack-row">
                  <input id="ackApplicant" name="ackApplicant" type="checkbox" aria-required="true" />
                  <label for="ackApplicant">
                    <strong>Applicant Pledge:</strong>
                    As a military-connected youth, I believe in the Child &amp; Youth Program&apos;s mission. I pledge to do my best as a State Teen Panel member - showing up, speaking up for my peers, and growing as a leader. I understand that missing required meetings may result in dismissal from the panel.
                  </label>
                </div>
                <div class="field-error" id="ackApplicant-error" aria-live="polite"></div>
              </div>

              <p class="fine-print">
                By checking these boxes you are providing your digital acknowledgement in place of a handwritten signature.
              </p>
            </div>
          </section>

          <div class="card" style="padding: 0;">
            <div class="section-body">
              <div class="submit-row">
                <p class="submit-help">Required fields must be complete before submission.</p>
                <button id="submitButton" class="button button-primary" type="submit">Submit Application</button>
              </div>
            </div>
          </div>
        </form>

        <footer class="footer">
          <strong>Chris Cox - Iowa National Guard Child &amp; Youth Program Coordinator</strong>
          christopher.j.cox18.ctr@army.mil  |  515-727-3064
          7105 NW 70th Ave, Johnston, IA 50131

          *Participation on the Iowa State Teen Panel is a statutory volunteer position.
          No payment for hours served; travel costs for designated events are reimbursed per travel regulations.*
        </footer>
      </section>
    </main>

    <script>
      const form = document.getElementById("stpApplicationForm");
      const applicationShell = document.getElementById("applicationShell");
      const continueButton = document.getElementById("continueButton");
      const gateResetButton = document.getElementById("gateResetButton");
      const eligibilityWarning = document.getElementById("eligibilityWarning");
      const successBanner = document.getElementById("successBanner");
      const successBannerTitle = document.getElementById("successBannerTitle");
      const successBannerText = document.getElementById("successBannerText");
      const submitButton = document.getElementById("submitButton");
      const eligibilityInputs = [
        document.getElementById("eligible-age"),
        document.getElementById("eligible-connected"),
        document.getElementById("eligible-commit"),
      ];

      const requiredFields = [
        "fullName",
        "age",
        "graduationYear",
        "mailingAddress",
        "city",
        "zip",
        "email",
        "cell",
        "tShirtSize",
        "guardianName",
        "relationship",
        "guardianCell",
        "guardianEmail",
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
      ];

      const requiredCheckboxes = ["ackParent", "ackApplicant"];
      const fieldIds = requiredFields.concat(requiredCheckboxes);
      const endpoint = "https://cyp-admin.netlify.app/api/submit-application";
      let applicationOpened = false;

      const getField = (name) => document.getElementById(name);
      const getErrorNode = (name) => document.getElementById(`${name}-error`);

      function firstNameFromFullName(value) {
        const text = String(value || "").trim();
        if (!text) return "friend";
        return text.split(/\s+/)[0] || "friend";
      }

      function allEligibilityChecked() {
        return eligibilityInputs.every((input) => input.checked);
      }

      function setEligibilityState() {
        continueButton.disabled = !allEligibilityChecked();
        if (applicationOpened && !allEligibilityChecked()) {
          eligibilityWarning.hidden = false;
        } else if (allEligibilityChecked()) {
          eligibilityWarning.hidden = true;
        }
      }

      function clearFieldError(name) {
        const field = getField(name);
        const error = getErrorNode(name);
        if (field) {
          field.setAttribute("aria-invalid", "false");
        }
        if (error) {
          error.textContent = "";
        }
      }

      function setFieldError(name, message) {
        const field = getField(name);
        const error = getErrorNode(name);
        if (field) {
          field.setAttribute("aria-invalid", "true");
        }
        if (error) {
          error.textContent = message;
        }
      }

      function clearAllErrors() {
        fieldIds.forEach(clearFieldError);
      }

      function showSuccess(message) {
        successBanner.classList.remove("is-error");
        successBannerTitle.textContent = "Application submitted";
        successBannerText.textContent = message;
        successBanner.hidden = false;
        successBanner.classList.add("is-visible");
        successBanner.scrollIntoView({ block: "start", behavior: "smooth" });
      }

      function showSubmitError(message) {
        successBanner.classList.add("is-error");
        successBannerTitle.textContent = "Submission problem";
        successBannerText.textContent = message;
        successBanner.hidden = false;
        successBanner.classList.add("is-visible");
        successBanner.scrollIntoView({ block: "start", behavior: "smooth" });
      }

      function validateField(name, validator) {
        const field = getField(name);
        if (!field) {
          return true;
        }

        const value = field.type === "checkbox" ? field.checked : field.value;
        const result = validator(field, value);
        if (result !== true) {
          setFieldError(name, result);
          return false;
        }

        clearFieldError(name);
        return true;
      }

      function validateForm() {
        clearAllErrors();
        let firstInvalid = null;
        const markInvalid = (name) => {
          if (!firstInvalid) {
            firstInvalid = getField(name);
          }
        };

        const setFail = (name, message) => {
          setFieldError(name, message);
          markInvalid(name);
        };

        const fullName = getField("fullName").value.trim();
        if (!fullName) setFail("fullName", "Full name is required.");

        const ageField = getField("age");
        const ageValue = Number(ageField.value);
        if (!ageField.value.trim()) {
          setFail("age", "Age is required.");
        } else if (!Number.isInteger(ageValue) || ageValue < 13 || ageValue > 17) {
          setFail("age", "Age must be between 13 and 17.");
        }

        if (!getField("graduationYear").value) setFail("graduationYear", "Select a graduation year.");
        if (!getField("mailingAddress").value.trim()) setFail("mailingAddress", "Mailing address is required.");
        if (!getField("city").value.trim()) setFail("city", "City is required.");
        if (!/^[0-9]{5}$/.test(getField("zip").value.trim())) setFail("zip", "ZIP must be exactly 5 digits.");

        const emailField = getField("email");
        if (!emailField.value.trim()) {
          setFail("email", "Email is required.");
        } else if (!emailField.checkValidity()) {
          setFail("email", "Enter a valid email address.");
        }

        if (!getField("cell").value.trim()) setFail("cell", "Cell phone is required.");
        if (!getField("tShirtSize").value) setFail("tShirtSize", "Select a shirt size.");

        if (!getField("guardianName").value.trim()) setFail("guardianName", "Parent/guardian name is required.");
        if (!getField("relationship").value.trim()) setFail("relationship", "Relationship is required.");
        if (!getField("guardianCell").value.trim()) setFail("guardianCell", "Guardian cell phone is required.");

        const guardianEmail = getField("guardianEmail");
        if (!guardianEmail.value.trim()) {
          setFail("guardianEmail", "Guardian email is required.");
        } else if (!guardianEmail.checkValidity()) {
          setFail("guardianEmail", "Enter a valid guardian email address.");
        }

        ["q1", "q2", "q3", "q4", "q5"].forEach((name, index) => {
          const field = getField(name);
          if (!field.value.trim()) {
            setFail(name, `Question ${index + 1} is required.`);
          }
        });

        requiredCheckboxes.forEach((name) => {
          if (!getField(name).checked) {
            setFail(name, "This acknowledgement is required.");
          }
        });

        if (firstInvalid) {
          firstInvalid.focus({ preventScroll: true });
          firstInvalid.scrollIntoView({ block: "center", behavior: "smooth" });
          return false;
        }

        return true;
      }

      function serializeForm() {
        const data = {
          applicant: {
            fullName: getField("fullName").value.trim(),
            age: Number(getField("age").value),
            graduationYear: getField("graduationYear").value,
            gender: getField("gender").value.trim() || null,
            mailingAddress: getField("mailingAddress").value.trim(),
            city: getField("city").value.trim(),
            zip: getField("zip").value.trim(),
            email: getField("email").value.trim(),
            cell: getField("cell").value.trim(),
            tShirtSize: getField("tShirtSize").value,
            preferredContact: getField("preferredContact").value.trim() || null,
          },
          guardian: {
            name: getField("guardianName").value.trim(),
            relationship: getField("relationship").value.trim(),
            cell: getField("guardianCell").value.trim(),
            workPhone: getField("guardianWorkPhone").value.trim() || null,
            email: getField("guardianEmail").value.trim(),
            name2: getField("guardianName2").value.trim() || null,
            cell2: getField("guardianCell2").value.trim() || null,
            email2: getField("guardianEmail2").value.trim() || null,
          },
          responses: {
            q1: getField("q1").value.trim(),
            q2: getField("q2").value.trim(),
            q3: getField("q3").value.trim(),
            q4: getField("q4").value.trim(),
            q5: getField("q5").value.trim(),
          },
          acknowledgements: {
            parentPermission: getField("ackParent").checked,
            applicantPledge: getField("ackApplicant").checked,
          },
          meta: {
            submittedAt: new Date().toISOString(),
            source: "stp-online-application",
          },
        };

        return data;
      }

      async function submitApplication(payload) {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        let result = null;
        try {
          result = await response.json();
        } catch (_error) {
          result = null;
        }

        if (!response.ok || result?.ok !== true) {
          const message = result?.error || `Submission endpoint returned ${response.status}`;
          throw new Error(message);
        }

        return result;
      }

      continueButton.addEventListener("click", () => {
        if (!allEligibilityChecked()) {
          return;
        }
        applicationOpened = true;
        applicationShell.classList.add("is-visible");
        eligibilityWarning.hidden = true;
        applicationShell.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      gateResetButton.addEventListener("click", () => {
        eligibilityInputs.forEach((input) => {
          input.checked = false;
        });
        setEligibilityState();
        if (applicationOpened && !allEligibilityChecked()) {
          eligibilityWarning.hidden = false;
        }
      });

      eligibilityInputs.forEach((input) => {
        input.addEventListener("change", () => {
          setEligibilityState();
        });
      });

      form.addEventListener("input", (event) => {
        const target = event.target;
        if (!target || !target.name) return;
        if (target.type === "checkbox") {
          clearFieldError(target.name);
        } else if (target.value.trim()) {
          clearFieldError(target.name);
        }
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearAllErrors();

        if (!allEligibilityChecked()) {
          eligibilityWarning.hidden = false;
          eligibilityWarning.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }

        if (!validateForm()) {
          return;
        }

        submitButton.disabled = true;
        submitButton.textContent = "Submitting...";

        const payload = serializeForm();
        try {
          await submitApplication(payload);
          showSuccess(`Thanks ${firstNameFromFullName(payload.applicant.fullName)}! Your application has been submitted. We'll be in touch soon.`);
          form.reset();
        } catch (error) {
          console.error("Application submission failed:", error);
          showSubmitError(error.message || "Unable to submit your application. Please try again.");
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = "Submit Application";
        }
      });

      setEligibilityState();
    </script>
  </body>
</html>
