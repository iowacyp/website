---
layout: layouts/base.njk
title: Rocktober · Fall Family Festival | Iowa CYP
description: Iowa CYP's Fall Family Festival goes Rocktober this year — Oct 24, 2-4 PM at Camp Dodge. Host a trunk, volunteer, or bring an activity for trunk-or-treat fun, youth bands, a carnival, mini golf, and candy.
permalink: /fall-family-festival/
socialImage: /assets/img/events/rocktober-2026-flyer.jpg
---

<style>
  .rocktober-page {
    --stage: #160f09;
    --stage-2: #251a10;
    --ink: #241608;
    --gold: #f4b41b;
    --rust: #c8531f;
    --blue: #1f4d7a;
    --paper: #fff8ea;
    position: relative;
    overflow: hidden;
    color: #f7efe2;
    background: var(--stage);
  }

  .rocktober-hero {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(244, 166, 59, 0.28), transparent 65%),
      var(--stage);
  }

  .rocktober-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .rocktober-poster {
    display: block;
    width: 100%;
    max-width: 56rem;
    height: auto;
    border-radius: 1.1rem;
    border: 3px solid rgba(244, 180, 27, 0.4);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .rocktober-hero__actions {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    max-width: 40rem;
  }

  .rocktober-lead {
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.7;
    color: rgba(247, 239, 226, 0.88);
    max-width: 40rem;
  }

  .rocktober-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.25rem;
  }

  .rocktober-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.9rem 1.5rem;
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .rocktober-btn--gold {
    background: var(--gold);
    color: var(--ink);
    box-shadow: 0 16px 30px -14px rgba(244, 180, 27, 0.65);
  }

  .rocktober-btn--gold:hover,
  .rocktober-btn--gold:focus-visible {
    background: #ffca3d;
    transform: translateY(-2px);
  }

  .rocktober-btn--ghost {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.45);
  }

  .rocktober-btn--ghost:hover,
  .rocktober-btn--ghost:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    transform: translateY(-2px);
  }

  .rocktober-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  /* Marquee ticker */
  .rocktober-ticker {
    position: relative;
    overflow: hidden;
    background: var(--stage-2);
    border-top: 2px solid rgba(244, 180, 27, 0.35);
    border-bottom: 2px solid rgba(244, 180, 27, 0.35);
  }

  .rocktober-ticker__track {
    display: flex;
    width: max-content;
    gap: 3rem;
    padding: 0.7rem 0;
    animation: rocktober-scroll 28s linear infinite;
  }

  .rocktober-ticker__track span {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(247, 239, 226, 0.85);
    white-space: nowrap;
  }

  @keyframes rocktober-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Stage / lineup section */
  .rocktober-stage {
    position: relative;
    padding-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 5.5rem);
    background:
      radial-gradient(ellipse 45% 40% at 90% 0%, rgba(244, 166, 59, 0.18), transparent 60%),
      var(--stage);
  }

  .rocktober-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .rocktober-grid {
      grid-template-columns: 1.05fr 1fr;
      align-items: start;
    }
  }

  .rocktober-kicker {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
    margin-bottom: 0.6rem;
  }

  .rocktober-h2 {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    color: #fff;
    line-height: 1.05;
    margin-bottom: 0.75rem;
  }

  .rocktober-h2--dark {
    color: var(--ink);
  }

  .rocktober-copy {
    line-height: 1.75;
    color: rgba(247, 239, 226, 0.82);
  }

  .rocktober-copy--dark {
    color: #5a4a38;
  }

  .rocktober-acts {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .rocktober-act {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(244, 180, 27, 0.25);
    border-radius: 1.25rem;
    padding: 1.15rem 1.35rem;
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  .rocktober-act:hover {
    border-color: rgba(244, 180, 27, 0.55);
    background: rgba(255, 255, 255, 0.07);
  }

  .rocktober-act__num {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1rem;
    box-shadow: 0 8px 18px -10px rgba(244, 180, 27, 0.7);
  }

  .rocktober-act__tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--rust);
    margin-bottom: 0.15rem;
  }

  .rocktober-act__title {
    font-family: var(--font-heading);
    text-transform: none;
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .rocktober-act p:not(.rocktober-act__tag) {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(247, 239, 226, 0.78);
  }

  .rocktober-note {
    margin-top: 1.5rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(247, 239, 226, 0.65);
  }

  .rocktober-recap {
    margin-top: 2rem;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(244, 180, 27, 0.25);
    background: rgba(255, 255, 255, 0.03);
  }

  .rocktober-recap img {
    display: block;
    width: 100%;
    height: clamp(180px, 28vw, 260px);
    object-fit: cover;
    object-position: top;
  }

  .rocktober-recap figcaption {
    padding: 0.85rem 1.1rem;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: rgba(247, 239, 226, 0.65);
  }

  /* Ticket / signup card */
  .rocktober-ticket {
    scroll-margin-top: 6.5rem;
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .rocktober-ticket__stub {
    position: relative;
    background: var(--ink);
    background-image: radial-gradient(circle at 15% 30%, rgba(244, 180, 27, 0.25), transparent 55%);
    color: var(--gold);
    padding: 1rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .rocktober-ticket__stub::after {
    content: "";
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: -1px;
    border-bottom: 2px dashed rgba(244, 180, 27, 0.45);
  }

  .rocktober-ticket__body {
    padding: 1.75rem 1.5rem 2rem;
  }

  @media (min-width: 640px) {
    .rocktober-ticket__body {
      padding: 2.25rem 2.25rem 2.5rem;
    }
  }

  .rocktober-form {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .rocktober-form-row {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .rocktober-form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .rocktober-field label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  .rocktober-field input,
  .rocktober-field select,
  .rocktober-field textarea {
    width: 100%;
    border-radius: 0.85rem;
    border: 1px solid #e6d5a8;
    background: #fffdf6;
    padding: 0.65rem 0.85rem;
    color: #2a2338;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .rocktober-field input:focus,
  .rocktober-field select:focus,
  .rocktober-field textarea:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(31, 77, 122, 0.15);
  }

  .rocktober-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: #5a4a38;
  }

  .rocktober-consent input {
    margin-top: 0.2rem;
    height: 1rem;
    width: 1rem;
    border-radius: 0.3rem;
    border: 1px solid #cbb98a;
    accent-color: var(--blue);
  }

  .rocktober-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    border-radius: 999px;
    padding: 0.9rem 1.75rem;
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--rust);
    color: #fff;
    box-shadow: 0 16px 30px -14px rgba(200, 83, 31, 0.55);
    transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
  }

  .rocktober-submit:hover {
    background: #de6329;
    transform: translateY(-2px);
  }

  .rocktober-submit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .rocktober-ticker__track {
      animation: none;
    }
    .rocktober-btn,
    .rocktober-submit {
      transition: none;
    }
  }
</style>

<div class="rocktober-page">

  <section class="rocktober-hero" data-reveal>
    <div class="container rocktober-hero__inner">
      <h1 class="sr-only">Rocktober &mdash; Fall Family Festival 2026</h1>
      <img class="rocktober-poster" src="/assets/img/events/rocktober-2026-flyer.jpg" alt="Rocktober, Fall Family Festival poster: October 24th, 2 to 4 PM, at Camp Dodge Pool Pavilion. Trunk or treat, youth bands, carnival, and candy." {{ imageAttrs('/assets/img/events/rocktober-2026-flyer.jpg') }} loading="eager" decoding="async">
      <div class="rocktober-hero__actions">
        <p class="rocktober-lead">Host a trunk, bring an activity, or lend a hand as Iowa Guard-connected families gather for trunk-or-treat fun, youth bands, a carnival, mini golf, and candy.</p>
        <div class="rocktober-cta-row">
          <a class="rocktober-btn rocktober-btn--gold" href="/register/e80bfe5f-23fc-49e4-86f7-2e61c1c40965">Families: register to attend</a>
          <a class="rocktober-btn rocktober-btn--ghost" href="#trunk-signup">Sign up to host a trunk</a>
        </div>
      </div>
    </div>
  </section>

  <div class="rocktober-ticker" aria-hidden="true">
    <div class="rocktober-ticker__track">
      <span>🍬 Trunk or treat</span>
      <span>★</span>
      <span>🥁 Youth bands</span>
      <span>★</span>
      <span>🎡 Carnival</span>
      <span>★</span>
      <span>⛳ Mini golf</span>
      <span>★</span>
      <span>🎃 Camp Dodge &middot; Oct 24, 2&ndash;4 PM</span>
      <span>★</span>
      <span>🍬 Trunk or treat</span>
      <span>★</span>
      <span>🥁 Youth bands</span>
      <span>★</span>
      <span>🎡 Carnival</span>
      <span>★</span>
      <span>⛳ Mini golf</span>
      <span>★</span>
      <span>🎃 Camp Dodge &middot; Oct 24, 2&ndash;4 PM</span>
      <span>★</span>
    </div>
  </div>

  <section class="rocktober-stage" data-reveal>
    <div class="container rocktober-grid">
      <div>
        <p class="rocktober-kicker">Ways to support</p>
        <h2 class="rocktober-h2">Join the lineup</h2>
        <p class="rocktober-copy">A decorated trunk is a simple, memorable way to welcome families. You can also volunteer at an activity or tell us how your organization would like to help.</p>

        <div class="rocktober-acts">
          <article class="rocktober-act">
            <span class="rocktober-act__num" aria-hidden="true">01</span>
            <div>
              <p class="rocktober-act__tag">Headliner</p>
              <h3 class="rocktober-act__title">Host a trunk</h3>
              <p>Decorate, hand out treats, and create a friendly stop for families.</p>
            </div>
          </article>
          <article class="rocktober-act">
            <span class="rocktober-act__num" aria-hidden="true">02</span>
            <div>
              <p class="rocktober-act__tag">Crew</p>
              <h3 class="rocktober-act__title">Volunteer</h3>
              <p>Help with welcome, activities, setup, or cleanup.</p>
            </div>
          </article>
          <article class="rocktober-act">
            <span class="rocktober-act__num" aria-hidden="true">03</span>
            <div>
              <p class="rocktober-act__tag">Guest spot</p>
              <h3 class="rocktober-act__title">Partner</h3>
              <p>Bring an activity, supplies, or a community resource to share.</p>
            </div>
          </article>
        </div>

        <p class="rocktober-note">After you sign up, the Iowa CYP team will confirm details and send event updates by email.</p>

        <figure class="rocktober-recap">
          <img src="/assets/img/events/previous-years/fall-family-festival.webp" alt="Families and volunteers smiling together at a past Fall Family Festival trunk-or-treat table" {{ imageAttrs('/assets/img/events/previous-years/fall-family-festival.webp') }} loading="lazy" decoding="async">
          <figcaption>From a past Fall Family Festival &mdash; real trunks, real fun.</figcaption>
        </figure>
      </div>

      <div id="trunk-signup" class="rocktober-ticket">
        <div class="rocktober-ticket__stub">
          <span>Admit one</span>
          <span>Rocktober &middot; 2026</span>
        </div>
        <div class="rocktober-ticket__body">
          <p class="rocktober-kicker">Festival support signup</p>
          <h2 class="rocktober-h2 rocktober-h2--dark">Reserve your spot</h2>
          <p class="rocktober-copy rocktober-copy--dark">Choose how you would like to help. We will use your information only to coordinate the festival and share related updates.</p>

          <form class="rocktober-form" data-festival-trunk-form novalidate>
            <div class="hidden" aria-hidden="true">
              <label for="festival-company">Leave this blank</label>
              <input id="festival-company" name="bot-field" type="text" tabindex="-1" autocomplete="off">
            </div>
            <div class="rocktober-form-row">
              <div class="rocktober-field">
                <label for="festival-name">Name</label>
                <input id="festival-name" name="name" autocomplete="name" required>
              </div>
              <div class="rocktober-field">
                <label for="festival-organization">Organization (optional)</label>
                <input id="festival-organization" name="organization" autocomplete="organization">
              </div>
            </div>
            <div class="rocktober-form-row">
              <div class="rocktober-field">
                <label for="festival-email">Email</label>
                <input id="festival-email" name="email" type="email" autocomplete="email" required>
              </div>
              <div class="rocktober-field">
                <label for="festival-phone">Phone (optional)</label>
                <input id="festival-phone" name="phone" type="tel" autocomplete="tel">
              </div>
            </div>
            <div class="rocktober-field">
              <label for="festival-role">How would you like to help?</label>
              <select id="festival-role" name="support_role" required>
                <option value="">Select one</option>
                <option value="trunk">Host a trunk</option>
                <option value="volunteer">Volunteer</option>
                <option value="partner">Community partner / activity</option>
              </select>
            </div>
            <div class="rocktober-field">
              <label for="festival-details">Tell us about your trunk or support idea (optional)</label>
              <textarea id="festival-details" name="details" rows="4"></textarea>
            </div>
            <label class="rocktober-consent" for="festival-consent">
              <input id="festival-consent" name="consent" type="checkbox" value="true" required>
              <span>I agree that Iowa CYP may contact me about my Fall Family Festival support signup.</span>
            </label>
            <p class="text-sm text-slate-600" role="status" aria-live="polite" data-festival-trunk-status></p>
            <button class="rocktober-submit" type="submit" data-festival-trunk-submit>Send signup</button>
          </form>
        </div>
      </div>
    </div>
  </section>

</div>
