    </div>
    <a class="btn" href="mailto:{{ site.contactEmail }}">Email the team</a>
  </div>
</section>

<script>
(function () {
  // ── Audience filter ──────────────────────────────────────────────────────
  const audienceBtns = document.querySelectorAll('.mh-filter-btn');
  const allCards     = document.querySelectorAll('[data-mh-card]');
  const allSections  = document.querySelectorAll('[data-mh-section]');
  let activeAudience = 'all';
  let activeRegion   = 'all';

  function applyFilters() {
    allCards.forEach(function (card) {
      const audience = (card.dataset.audience || '').split(' ');
      const region   = card.dataset.region || '';
      const isRegionCard = !!card.dataset.region;

      const audienceOk = activeAudience === 'all' || audience.includes(activeAudience);
      const regionOk   = !isRegionCard || activeRegion === 'all' || region === activeRegion;

      card.hidden = !(audienceOk && regionOk);
    });

    // Hide/show entire sections based on whether any card is visible
    allSections.forEach(function (section) {
      const sectionCards = section.querySelectorAll('[data-mh-card]');
      const anyVisible   = Array.from(sectionCards).some(function (c) { return !c.hidden; });
      section.style.display = anyVisible ? '' : 'none';
    });

    // Show/hide counseling empty state
    var grid = document.getElementById('counselingGrid');
    var empty = document.getElementById('counselingEmpty');
    if (grid && empty) {
      var visibleCounseling = Array.from(grid.querySelectorAll('[data-mh-card]')).some(function (c) { return !c.hidden; });
      empty.classList.toggle('hidden', visibleCounseling);
    }
  }

  audienceBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      activeAudience = btn.dataset.filter;
      audienceBtns.forEach(function (b) {
        var active = b === btn;
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
        b.classList.toggle('bg-primary',     active);
        b.classList.toggle('text-white',     active);
        b.classList.toggle('border-primary', active);
        b.classList.toggle('bg-white',       !active);
        b.classList.toggle('text-slate-600', !active);
        b.classList.toggle('border-slate-300', !active);
      });
      applyFilters();
    });
  });

  // ── Region filter ────────────────────────────────────────────────────────
  const regionBtns = document.querySelectorAll('.mh-region-btn');

  function setRegion(value) {
    activeRegion = value;
    regionBtns.forEach(function (b) {
      var active = b.dataset.region === value;
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
      b.classList.toggle('bg-primary',     active);
      b.classList.toggle('text-white',     active);
      b.classList.toggle('border-primary', active);
      b.classList.toggle('bg-white',       !active);
      b.classList.toggle('text-slate-600', !active);
      b.classList.toggle('border-slate-300', !active);
    });
    applyFilters();
  }

  regionBtns.forEach(function (btn) {
    btn.addEventListener('click', function () { setRegion(btn.dataset.region); });
  });

  var resetBtn = document.getElementById('counselingReset');
  if (resetBtn) {
    resetBtn.addEventListener('click', function () { setRegion('all'); });
  }

  // ── Highlight active jump link on scroll ─────────────────────────────────
  var sections = Array.from(document.querySelectorAll('section[id]'));
  var jumpLinks = document.querySelectorAll('#mhJumpNav a');

  if ('IntersectionObserver' in window && sections.length && jumpLinks.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var id = entry.target.id;
        jumpLinks.forEach(function (a) {
          var matches = a.getAttribute('href') === '#' + id;
          a.classList.toggle('bg-primary/10', matches);
          a.classList.toggle('text-primary',  matches);
          a.classList.toggle('font-semibold', matches);
        });
      });
    }, { rootMargin: '-30% 0px -60% 0px' });

    sections.forEach(function (s) { io.observe(s); });
  }
}());
</script>
