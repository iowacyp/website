<section class="container pt-10 pb-16 md:pb-20" data-reveal>
  <div class="content-card md:flex md:items-center md:justify-between md:gap-8 space-y-6 md:space-y-0">
    <div class="space-y-2">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Need more help?</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">We can help you find the right fit</h2>
