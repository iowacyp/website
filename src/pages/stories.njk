<section id="voices" class="bg-primary/5 py-14 md:py-16" data-reveal>
  <div class="container space-y-10">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm uppercase tracking-[0.15em] text-primary/70">Voices you can trust</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Why steady support matters statewide</h2>
      <p class="text-slate-700 leading-relaxed">Parents, teens, youth, and caregivers keep us honest. These quotes show what stays with them long after an event or program ends.</p>
    </div>
    <div class="quote-carousel" data-quote-carousel>
      <div class="content-card quote-carousel__slides" role="region" aria-live="polite">
        {% for quote in voiceQuotes %}
          {% set attribution = quote.role or quote.author %}
          <figure class="quote-slide {% if loop.first %}is-active{% endif %}" data-quote-slide>
            <blockquote class="text-primary text-lg italic leading-relaxed">&ldquo;{{ quote.text }}&rdquo;</blockquote>
            {% if attribution %}
              <figcaption class="mt-4 text-xs uppercase tracking-wide text-slate-500">{{ attribution }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
      <div class="quote-carousel__controls" aria-label="Quote navigation">
        <button type="button" class="quote-nav-btn" data-quote-prev aria-label="Previous quote">
          <span aria-hidden="true">&larr;</span>
        </button>
        <div class="quote-carousel__dots" role="tablist">
          {% for quote in voiceQuotes %}
            <button
              type="button"
              class="quote-dot {% if loop.first %}is-active{% endif %}"
              data-quote-dot="{{ loop.index0 }}"
              aria-label="Show quote {{ loop.index }}"
              role="tab"
              {% if loop.first %}aria-selected="true"{% else %}aria-selected="false"{% endif %}
            >
              <span class="sr-only">Quote {{ loop.index }}</span>
            </button>
          {% endfor %}
        </div>
        <button type="button" class="quote-nav-btn" data-quote-next aria-label="Next quote">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>
  </div>
</section>
