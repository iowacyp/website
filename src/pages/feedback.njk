---
layout: layouts/base.njk
title: Event Feedback
description: Share feedback about your Iowa Child & Youth Program event experience.
permalink: /feedback/
robots: noindex, follow
---
<section class="section bg-slate-50 min-h-[70vh]">
  <div class="container max-w-3xl">
    <div class="rounded-2xl bg-white p-6 shadow-sm sm:p-10">
      <h1 class="text-3xl font-semibold text-primary">Feedback</h1>
      <p class="mt-4 text-slate-700">Your voice matters! We use this feedback to improve our programs and show decision-makers why CYP is essential to Iowa’s military families. Thank you for sharing your experience—your story could help protect this program for others.</p>
      <p class="mt-3 font-medium text-primary" data-feedback-event></p>
      <form class="mt-8 space-y-6" data-event-feedback-form hidden>
        <fieldset><legend class="font-semibold">How likely are you to recommend CYP events to other military families? *</legend><div class="mt-3 flex flex-wrap gap-2">{% for score in range(0, 11) %}<label class="cursor-pointer"><input class="peer sr-only" type="radio" name="recommend_score" value="{{ score }}" required><span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-white">{{ score }}</span></label>{% endfor %}</div><div class="mt-2 flex justify-between text-xs text-slate-500"><span>Not at all likely</span><span>Extremely likely</span></div></fieldset>
        <label class="block font-semibold">What stood out most about this event for your child or family? (1–2 sentences) *<textarea class="mt-2 w-full rounded-lg border border-slate-300 p-3" name="stood_out" rows="3" required></textarea></label>
        <label class="block font-semibold">How has CYP supported you during your Guard service (e.g., during deployment, transitions, stress)?<textarea class="mt-2 w-full rounded-lg border border-slate-300 p-3" name="guard_support" rows="3"></textarea></label>
        <label class="block font-semibold">Did this event help your family feel more connected or supported as part of the military community? *<select class="mt-2 w-full rounded-lg border border-slate-300 p-3" name="connected_supported" required><option value="">Select one</option><option>Yes</option><option>Somewhat</option><option>No</option></select></label>
        <label class="block font-semibold">Would you be open to sharing your family’s story or experience with CYP to help show its impact? *<select class="mt-2 w-full rounded-lg border border-slate-300 p-3" name="share_story" required><option value="">Select one</option><option>Yes</option><option>Maybe—please contact me</option><option>No</option></select></label>
        <label class="block font-semibold">Is there anything you’d like to add that would help Guard leadership or decision-makers understand why programs like this are important for military families?<textarea class="mt-2 w-full rounded-lg border border-slate-300 p-3" name="leadership_message" rows="4"></textarea></label>
        <p data-feedback-status role="status" aria-live="polite"></p><button class="btn" type="submit">Submit feedback</button>
      </form>
      <p class="mt-6" data-feedback-loading>Loading your feedback form…</p>
    </div>
  </div>
</section>
<script>
(() => {
  const form = document.querySelector('[data-event-feedback-form]'); if (!form) return;
  const status = document.querySelector('[data-feedback-status]'); const loading = document.querySelector('[data-feedback-loading]');
  const token = new URLSearchParams(location.search).get('token') || location.pathname.split('/').filter(Boolean).pop();
  fetch('/.netlify/functions/event-feedback-proxy?token=' + encodeURIComponent(token)).then(r => r.json().then(data => ({r,data}))).then(({r,data}) => {
    if (!r.ok || !data.ok) throw new Error(data.error || 'Unable to open this feedback form.');
    document.querySelector('[data-feedback-event]').textContent = data.event_name;
    loading.hidden = true; if (data.completed) { loading.hidden = false; loading.textContent = 'Thank you—your feedback has already been received.'; return; } form.hidden = false;
  }).catch(error => { loading.textContent = error.message; });
  form.addEventListener('submit', async event => { event.preventDefault(); if (!form.checkValidity()) return form.reportValidity();
    const button=form.querySelector('button'); button.disabled=true; status.textContent='Submitting…'; const responses=Object.fromEntries(new FormData(form).entries());
    try { const r=await fetch('/.netlify/functions/event-feedback-proxy',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({token,responses})}); const data=await r.json(); if(!r.ok||!data.ok) throw new Error(data.error||'Unable to save feedback.'); form.innerHTML='<p class="text-lg font-semibold text-green-700">Thank you! Your feedback has been received.</p>'; }
    catch(error){ status.textContent=error.message; button.disabled=false; }
  });
})();
</script>
