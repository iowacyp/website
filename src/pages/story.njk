---
layout: layouts/base.njk
pagination:
  data: storyGallery.items
  size: 1
  alias: story
  addAllPagesToCollections: true
permalink: /stories/{{ story.id }}/index.html
searchExclude: true
eleventyComputed:
  title: "{{ story.title | safe }} | Iowa CYP"
  description: "{{ story.hook }}"
  socialImage: "{{ story.image }}"
  ogType: "article"
---
<article class="bg-white">
  <header class="relative min-h-[55vh] overflow-hidden bg-slate-950 text-white">
    <img src="{{ story.image }}" alt="" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-45 blur-2xl" aria-hidden="true" decoding="async">
    <img src="{{ story.image }}" alt="{{ story.alt }}" class="absolute inset-0 h-full w-full object-contain" {{ imageAttrs(story.image) | safe }} decoding="async">
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/35 to-transparent"></div>
    <div class="container relative flex min-h-[55vh] items-end py-10 md:py-14">
      <div class="max-w-4xl rounded-[1.75rem] border border-white/15 bg-slate-950/85 p-6 shadow-2xl backdrop-blur-md md:p-8">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-secondary">{{ story.eyebrow }}</p>
        <h1 class="mt-3 text-3xl font-semibold leading-tight text-white md:text-5xl">{{ story.title }}</h1>
        <p class="mt-4 text-sm uppercase tracking-[0.18em] text-white/60">{{ story.published }}</p>
      </div>
    </div>
  </header>

  <div class="container grid gap-10 py-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:py-16">
    <div class="space-y-6 text-lg leading-relaxed text-slate-700">
      {% for paragraph in story.body %}<p>{{ paragraph }}</p>{% endfor %}
    </div>
    <aside class="space-y-5">
      <blockquote class="rounded-3xl border-l-4 border-secondary bg-secondary/10 p-6 text-xl font-semibold leading-snug text-slate-900">
        <p>&ldquo;{{ story.quote }}&rdquo;</p>
        {% if story.quoteAttribution %}<cite class="mt-4 block text-sm font-bold not-italic uppercase tracking-[0.16em] text-primary/60">&mdash; {{ story.quoteAttribution }}</cite>{% endif %}
      </blockquote>
      <div class="rounded-3xl border border-primary/15 bg-primary/5 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-primary/60">Why it matters</p>
        <p class="mt-3 leading-relaxed text-slate-700">{{ story.impact }}</p>
      </div>
      {% if story.stats and story.stats.length %}
        <dl class="grid grid-cols-2 gap-3">
          {% for stat in story.stats %}
            <div class="rounded-2xl bg-primary/5 p-4">
              <dt class="text-2xl font-bold text-primary">{{ stat.value }}</dt>
              <dd class="mt-1 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{{ stat.label }}</dd>
            </div>
          {% endfor %}
        </dl>
      {% endif %}
    </aside>
  </div>

  {% if story.youtubeId %}
    <section class="bg-slate-900 py-12 text-white" aria-labelledby="story-video-heading">
      <div class="container grid gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:items-center">
        <div class="space-y-4">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-secondary">Watch the story</p>
          <h2 id="story-video-heading" class="text-2xl font-semibold text-white md:text-3xl">Hear the family perspective</h2>
          <p class="leading-relaxed text-white/75">Listen to the story in the family's own words.</p>
          <a class="btn-secondary inline-flex items-center gap-2" href="{{ story.videoUrl }}" target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="frame-shell aspect-video overflow-hidden rounded-3xl border border-white/15 bg-black" data-frame-shell>
          <iframe data-frame-src="https://www.youtube.com/embed/{{ story.youtubeId }}?rel=0&amp;modestbranding=1&amp;playsinline=1" data-frame-eager title="{{ story.title }} video" class="frame-embed h-full w-full" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      </div>
    </section>
  {% endif %}

  {% if story.gallery and story.gallery.length > 1 %}
    <section class="bg-primary/5 py-12" aria-labelledby="story-gallery-heading">
      <div class="container space-y-6">
        <h2 id="story-gallery-heading" class="text-2xl font-semibold text-slate-900">More from this story</h2>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-3">
          {% for image in story.gallery %}
            <figure class="overflow-hidden rounded-2xl bg-slate-200">
              <img src="{{ image.src }}" alt="{{ image.alt }}" class="h-full min-h-64 w-full object-cover" {{ imageAttrs(image.src) | safe }} loading="lazy" decoding="async">
            </figure>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if story.morePhotosUrl %}
    <section class="border-t border-primary/10 bg-white py-12" aria-labelledby="more-story-photos-heading">
      <div class="container">
        <div class="flex flex-col gap-6 rounded-3xl border border-primary/15 bg-primary/5 p-6 shadow-sm md:flex-row md:items-center md:justify-between md:p-8">
          <div class="max-w-2xl space-y-2">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-primary/60">More moments</p>
            <h2 id="more-story-photos-heading" class="text-2xl font-semibold text-slate-900">See more photos from this story</h2>
            <p class="leading-relaxed text-slate-700">Continue exploring the event through Iowa CYP's full Facebook photo post.</p>
          </div>
          <a class="btn-primary inline-flex shrink-0 items-center justify-center gap-2" href="{{ story.morePhotosUrl }}" target="_blank" rel="noopener noreferrer">
            View photos on Facebook <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  {% endif %}

  <footer class="border-t border-slate-200 py-10">
    <div class="container">
      <a class="btn-primary inline-flex items-center gap-2" href="/stories/"><span aria-hidden="true">&larr;</span> All stories</a>
    </div>
  </footer>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ story.title | dump | safe }},
  "description": {{ story.hook | dump | safe }},
  "image": "{{ site.domain }}{{ story.image }}",
{% if story.publishedISO %}  "datePublished": "{{ story.publishedISO }}",
  "dateModified": "{{ story.publishedISO }}",{% endif %}
  "author": {
    "@type": "Organization",
    "name": {{ site.name | dump | safe }}
  },
  "mainEntityOfPage": "{{ site.domain }}{{ page.url }}",
  "publisher": {
    "@type": "Organization",
    "name": {{ site.name | dump | safe }},
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.domain }}/assets/img/branding_symbol.png"
    }
  }
}
</script>
