---
layout: layouts/base.njk
title: State Teen Panel Support Youth Volunteer Application | Iowa CYP
description: Apply to support Iowa CYP and the State Teen Panel as a supervised, non-specified youth volunteer.
permalink: /youth-volunteer-application/index.html
robots: noindex, follow
---
<section class="bg-primary/5 py-16 md:py-20" data-reveal>
  <div class="container max-w-4xl">
    <div class="content-card space-y-8">
      <header class="space-y-4 text-center">
        <p class="text-sm uppercase tracking-[0.15em] text-primary/70">State Teen Panel Support Youth Volunteer</p>
        <h1 class="text-3xl md:text-4xl font-semibold text-slate-900">Apply to support STP</h1>
        <p class="mx-auto max-w-2xl text-slate-700 leading-relaxed">This is a supervised youth service role for young people who want to support Iowa CYP and State Teen Panel activities. Military affiliation is not required, and this role does not make a youth an official STP delegate.</p>
      </header>

      <div class="rounded-2xl border border-secondary/30 bg-secondary/10 p-5 text-sm text-slate-800 leading-relaxed">
        <p class="font-semibold text-base">Before you begin</p>
        <p class="mt-2">A parent or legal guardian must complete this form with the youth. A CYP team member will review the application, discuss available opportunities, and provide any required orientation before volunteer service begins.</p>
      </div>

      <div id="youthVolunteerStatus" class="hidden rounded-2xl border p-4 text-sm" role="status" aria-live="polite"></div>

      <form id="youthVolunteerForm" class="space-y-8" novalidate>
        <fieldset class="space-y-5">
          <legend class="text-xl font-semibold text-slate-900">About the youth volunteer</legend>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="space-y-2 text-sm font-medium text-slate-800">Youth's full name
              <input name="youthName" required autocomplete="name" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">Age
              <input name="youthAge" required type="number" min="1" max="17" inputmode="numeric" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">Youth email <span class="font-normal text-slate-500">(if available)</span>
              <input name="youthEmail" type="email" autocomplete="email" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">City
              <input name="city" required autocomplete="address-level2" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
          </div>
          <label class="block space-y-2 text-sm font-medium text-slate-800">What interests you about volunteering with STP and Iowa CYP?
            <textarea name="interest" required rows="4" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"></textarea>
          </label>
        </fieldset>

        <fieldset class="space-y-5 border-t border-slate-200 pt-8">
          <legend class="text-xl font-semibold text-slate-900">Parent or guardian contact</legend>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="space-y-2 text-sm font-medium text-slate-800">Parent/guardian full name
              <input name="guardianName" required autocomplete="name" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">Relationship to youth
              <input name="guardianRelationship" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">Email
              <input name="guardianEmail" required type="email" autocomplete="email" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">Phone
              <input name="guardianPhone" required type="tel" autocomplete="tel" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
          </div>
        </fieldset>

        <fieldset class="space-y-5 border-t border-slate-200 pt-8">
          <legend class="text-xl font-semibold text-slate-900">Volunteer agreement</legend>
          <p class="text-sm text-slate-600 leading-relaxed">Please review the agreement together. These acknowledgments keep the application simple while confirming the role’s important expectations.</p>
          <details class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
            <summary class="cursor-pointer font-semibold text-slate-900">Read the role expectations and limitations</summary>
            <div class="mt-4 space-y-3 leading-relaxed">
              <p>The volunteer may assist with approved teen activities, events, outreach, service projects, set-up, clean-up, and youth feedback under CYP direction.</p>
              <p>Youth volunteers are non-specified volunteers and are always under direct, line-of-sight supervision by designated CYP staff or an authorized adult volunteer. They may not independently supervise youth, be the responsible adult for an activity or transportation, have unsupervised one-on-one interactions with participants, handle restricted materials, or represent themselves as employees, military personnel, or official STP delegates.</p>
              <p>Participation is voluntary and may be modified, paused, or ended by CYP based on safety, program needs, conduct, availability, or parent/guardian consent. Required orientation may cover youth protection, safety, conduct, privacy, and role-specific instructions.</p>
            </div>
          </details>
          <div class="space-y-4 text-sm text-slate-700">
            <label class="flex items-start gap-3"><input name="youthAgreement" required type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary"><span>The youth understands this is a supervised support role—not official State Teen Panel membership or representation—and agrees to follow CYP rules, adult direction, and conduct expectations.</span></label>
            <label class="flex items-start gap-3"><input name="guardianConsent" required type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary"><span>I am the youth’s parent or legal guardian. I give permission for the youth to be considered for this voluntary role and understand that approval, orientation, and direct adult supervision are required before service begins.</span></label>
            <label class="flex items-start gap-3"><input name="guardianAgreement" required type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary"><span>I understand this role does not create employment, military membership, pay, benefits, or reimbursement, and that CYP may modify or end assignments as needed.</span></label>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="space-y-2 text-sm font-medium text-slate-800">Youth typed name
              <input name="youthTypedName" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
            <label class="space-y-2 text-sm font-medium text-slate-800">Parent/guardian typed name
              <input name="guardianTypedName" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            </label>
          </div>
        </fieldset>

        <div class="flex flex-col items-center gap-3 border-t border-slate-200 pt-8">
          <button id="youthVolunteerSubmit" type="submit" class="btn">Submit volunteer application</button>
          <p class="text-center text-xs text-slate-500">CYP will contact the parent or guardian about next steps.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.getElementById("youthVolunteerForm");
    const status = document.getElementById("youthVolunteerStatus");
    const submitButton = document.getElementById("youthVolunteerSubmit");
    const endpoint = "https://cyp-admin.netlify.app/api/submit-stp-support-youth-volunteer";

    function showStatus(message, type) {
      status.textContent = message;
      status.className = `rounded-2xl border p-4 text-sm ${type === "success" ? "border-emerald-300 bg-emerald-50 text-emerald-900" : "border-red-300 bg-red-50 text-red-900"}`;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      submitButton.disabled = true;
      submitButton.textContent = "Submitting…";
      const fields = new FormData(form);
      const payload = {
        youth: { name: fields.get("youthName"), age: fields.get("youthAge"), email: fields.get("youthEmail"), city: fields.get("city"), interest: fields.get("interest"), typedName: fields.get("youthTypedName") },
        guardian: { name: fields.get("guardianName"), relationship: fields.get("guardianRelationship"), email: fields.get("guardianEmail"), phone: fields.get("guardianPhone"), typedName: fields.get("guardianTypedName") },
        agreement: { youth: fields.get("youthAgreement") === "on", guardianConsent: fields.get("guardianConsent") === "on", guardian: fields.get("guardianAgreement") === "on" },
        submittedAt: new Date().toISOString(),
      };
      try {
        const response = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.ok !== true) throw new Error(result.error || "We could not submit your application. Please try again.");
        form.reset();
        showStatus("Thank you—your youth volunteer application has been received. A CYP team member will contact the parent or guardian about next steps.", "success");
      } catch (error) {
        showStatus(error.message || "We could not submit your application. Please try again.", "error");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Submit volunteer application";
      }
    });
  })();
</script>
