{
  "name": "iowacyp-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ELEVENTY_ENV=dev concurrently \"npm:watch:css\" \"npm:serve\"",
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && eleventy && npm run build:css",
    "verify:build": "node scripts/verify-build.mjs",
    "check:asset-sizes": "node scripts/check-asset-sizes.mjs",
    "build:prod": "npm run build && npm run verify:build && npm run check:asset-sizes",
    "serve": "eleventy --serve --quiet",
    "watch:css": "postcss src/assets/css/tailwind.css -o dist/assets/css/site.css --watch",
    "build:css": "postcss src/assets/css/tailwind.css -o dist/assets/css/site.css",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "googleapis": "^140.0.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.10"
  }
}
